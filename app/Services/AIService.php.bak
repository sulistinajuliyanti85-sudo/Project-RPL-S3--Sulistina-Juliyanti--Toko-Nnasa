    /**
     * Coupon / Voucher handler
     */
    private function handleCouponQuery(string $normalized, array &$context): array {
        $stmt = $this->db->prepare("SELECT * FROM coupons WHERE status = 'active' ORDER BY discount_value DESC LIMIT 3");
        $stmt->execute();
        $coupons = $stmt->fetchAll(PDO::FETCH_ASSOC);

        if (empty($coupons)) {
            return [
                'success' => true,
                'reply' => "Saat ini belum ada kode kupon baru yang aktif. Namun kamu tetap bisa menikmati harga promo langsung pada produk-produk bertanda diskon di katalog kami!",
                'products' => [],
                'suggestions' => ['Produk Promo', 'Katalog Aksesoris'],
                'provider' => 'builtin'
            ];
        }

        $lines = [];
        foreach ($coupons as $c) {
            $val = $c['discount_type'] === 'percentage' 
                ? "Diskon {$c['discount_value']}% (Maks. " . format_rupiah((float)$c['maximum_discount']) . ")"
                : "Potongan " . format_rupiah((float)$c['discount_value']);
            $min = format_rupiah((float)$c['minimum_purchase']);
            $lines[] = "- Kode: **`{$c['code']}`** ({$val}, Min. Belanja: {$min})";
        }

        $reply = "Kabar gembira! Ini voucher diskon aktif yang bisa kamu pakai saat checkout:\n\n"
               . implode("\n", $lines)
               . "\n\nCukup salin kodenya dan masukkan pada kolom voucher di halaman checkout ya! 🎉";

        return [
            'success' => true,
            'reply' => $reply,
            'products' => [],
            'suggestions' => ['Buka Katalog Produk', 'Cara Memakai Voucher', 'Produk Promo'],
            'provider' => 'builtin'
        ];
    }

    /**
     * Search products by specific color variant
     */
    private function searchProductsByColor(string $colorKey, array $synonyms): array {
        $found = [];
        $sql = "
            SELECT DISTINCT p.*, COALESCE(c.name, 'Tanpa Kategori') AS category_name, pv.variant_value, pv.stock AS variant_stock, pv.price_adjustment
            FROM products p
            JOIN product_variants pv ON p.id = pv.product_id
            LEFT JOIN categories c ON p.category_id = c.id
            WHERE p.status = 'active' AND pv.status = 'active' AND (
        ";

        $clauses = [];
        $params = [];
        foreach ($synonyms as $syn) {
            $clauses[] = "pv.variant_value LIKE ?";
            $params[] = "%{$syn}%";
        }
        $sql .= implode(' OR ', $clauses) . ") LIMIT 4";

        $stmt = $this->db->prepare($sql);
        $stmt->execute($params);
        $rows = $stmt->fetchAll(PDO::FETCH_ASSOC);

        foreach ($rows as $r) {
            $formatted = $this->productService->getProductStock($r['name']);
            if ($formatted) {
                $formatted['matched_variant'] = [
                    'variant_value' => $r['variant_value'],
                    'stock' => $r['variant_stock']
                ];
                $found[] = $formatted;
            }
        }

        return $found;
    }

    /**
     * Match query against category names/slugs
     */
    private function matchCategory(string $normalized): ?array {
        $stmt = $this->db->query("SELECT id, parent_id, name, slug FROM categories WHERE status = 'active'");
        $cats = $stmt->fetchAll(PDO::FETCH_ASSOC);

        foreach ($cats as $c) {
            $cNorm = $this->normalizeText($c['name']);
            if (str_contains($normalized, $cNorm) || str_contains($normalized, str_replace('-', ' ', $c['slug']))) {
                return $c;
            }
        }

        // Aliases
        $aliases = [
            'rambut' => 'Aksesoris Rambut',
            'jedai' => 'Jepit Rambut dan Hair Clip',
            'jepit' => 'Jepit Rambut dan Hair Clip',
            'hair clip' => 'Jepit Rambut dan Hair Clip',
            'scrunchie' => 'Ikat Rambut & Scrunchie',
            'ikat rambut' => 'Ikat Rambut & Scrunchie',
            'kalung' => 'Kalung',
            'gelang' => 'Gelang',
            'cincin' => 'Cincin',
            'anting' => 'Anting',
            'tas' => 'Aksesoris Tas & Keychain',
            'keychain' => 'Aksesoris Tas & Keychain',
            'bros' => 'Aksesoris Fashion',
            'bundling' => 'Paket Bundling',
            'kado' => 'Paket Bundling',
            'gift box' => 'Paket Bundling'
        ];

        foreach ($aliases as $alias => $targetCatName) {
            if (str_contains($normalized, $alias)) {
                foreach ($cats as $c) {
                    if ($c['name'] === $targetCatName) {
                        return $c;
                    }
                }
            }
        }

        return null;
    }

    /**
     * Dynamic Intent-to-Database Grounding Bridge for AI Assistant & Copilot
     * Detects keywords in admin message and queries real-time database to inject factual context
     */
    private function buildDynamicAdminGroundingContext(string $rawMessage, string $normalized, ?array $user): string {
        $sections = [];

        // REAL-TIME CORE STORE DASHBOARD METRICS (Data Riil Database untuk Admin)
        try {
            $revenue = (float)$this->db->query("SELECT COALESCE(SUM(total_amount), 0) FROM orders WHERE payment_status = 'paid'")->fetchColumn();
            $revFormatted = number_format($revenue, 0, ',', '.');
            $pendingOrders = (int)$this->db->query("SELECT COUNT(*) FROM orders WHERE order_status = 'pending'")->fetchColumn();
            $processingOrders = (int)$this->db->query("SELECT COUNT(*) FROM orders WHERE order_status = 'processing'")->fetchColumn();
            $totalActive = (int)$this->db->query("SELECT COUNT(*) FROM products WHERE status = 'active'")->fetchColumn();
            $totalCategories = (int)$this->db->query("SELECT COUNT(*) FROM categories")->fetchColumn();
            $totalStock = (int)$this->db->query("SELECT COALESCE(SUM(stock), 0) FROM products")->fetchColumn();
            $lowStock = (int)$this->db->query("SELECT COUNT(*) FROM products WHERE stock <= 5 AND status = 'active'")->fetchColumn();
            $completedOrders = (int)$this->db->query("SELECT COUNT(*) FROM orders WHERE order_status IN ('completed', 'delivered')")->fetchColumn();

            // Query 5 Pesanan Terbaru (Detail Baris Tabel Database Ringkas)
            $stmtRecent = $this->db->query("
                SELECT o.order_number, u.name as customer_name, o.total_amount, o.payment_status, o.order_status
                FROM orders o
                JOIN users u ON o.user_id = u.id
                ORDER BY o.id DESC
                LIMIT 5
            ");
            $recentOrders = $stmtRecent->fetchAll(PDO::FETCH_ASSOC);

            $recentLines = [];
            foreach ($recentOrders as $ro) {
                $payText = ($ro['payment_status'] === 'paid') ? 'Lunas' : 'Belum Dibayar';
                $stMap = [
                    'pending' => 'Menunggu Pembayaran',
                    'processing' => 'Diproses',
                    'shipped' => 'Sedang Dikirim',
                    'delivered' => 'Selesai',
                    'completed' => 'Selesai',
                    'cancelled' => 'Dibatalkan'
                ];
                $stText = $stMap[$ro['order_status']] ?? ucfirst($ro['order_status']);
                $amtText = 'Rp ' . number_format((float)$ro['total_amount'], 0, ',', '.');
                $recentLines[] = "- {$ro['order_number']}, Pelanggan: {$ro['customer_name']}, Total: {$amtText}, Pembayaran: {$payText}, Status: {$stText}.";
            }
            $recentOrdersFormatted = implode("\n", $recentLines);

            $sections[] = "Anda adalah Asisten Admin Nnaco.SA. Jawab pertanyaan admin secara ringkas dan akurat berdasarkan data rill database berikut ini:\n"
                . "DATA AGREGAT TOKO: Pendapatan: Rp {$revFormatted}, Pesanan Belum Bayar: {$pendingOrders}, Pesanan Perlu Diproses: {$processingOrders}, Produk Aktif: {$totalActive}, Total Kategori: {$totalCategories}, Total Unit Stok: {$totalStock}.\n\n"
                . "DETAIL 10 PESANAN TERBARU (TABEL DATABASE):\n"
                . "{$recentOrdersFormatted}\n\n"
                . "ATURAN: Jika data yang ditanyakan (seperti nama pelanggan, nominal, status pembayaran atau status pesanan) ada pada data di atas, berikan jawaban langsung tanpa bertele-tele.";
        } catch (Exception $e) {
            // Silently ignore if DB read fails
        }

        // 1. INTENT A: Stock & Low-Stock / Out-of-Stock Query
        if (str_contains($normalized, 'stok') || str_contains($normalized, 'stock') || str_contains($normalized, 'sisa') || str_contains($normalized, 'habis') || str_contains($normalized, 'menipis')) {
            $threshold = 5;
            if (preg_match('/(?:kurang dari|di bawah|dibawah|<|sisa)\s*([0-9]+)/i', $normalized, $matches)) {
                $threshold = (int)$matches[1];
            }

            $stmtStock = $this->db->prepare("
                SELECT p.name, p.sku, p.stock, p.price, COALESCE(c.name, 'Aksesoris') AS category_name
                FROM products p
                LEFT JOIN categories c ON p.category_id = c.id
                WHERE p.status = 'active' AND p.stock < ?
                ORDER BY p.stock ASC
            ");
            $stmtStock->execute([$threshold]);
            $lowProducts = $stmtStock->fetchAll(PDO::FETCH_ASSOC);

            $stockLines = ["[DATA INTERNAL DATABASE: PRODUK DENGAN STOK DI BAWAH {$threshold} UNIT]"];
            if (!empty($lowProducts)) {
                $stockLines[] = "Total ditemukan: " . count($lowProducts) . " produk dengan sisa stok < {$threshold}:";
                foreach ($lowProducts as $lp) {
                    $stockLines[] = "- {$lp['name']} (SKU: {$lp['sku']}, Kategori: {$lp['category_name']}) -> Sisa Stok: {$lp['stock']} unit (Harga: Rp " . number_format($lp['price'], 0, ',', '.') . ")";
                }
            } else {
                $stockLines[] = "Semua produk aktif memiliki stok aman (>= {$threshold} unit). Tidak ada produk dengan stok < {$threshold} unit.";
            }
            $sections[] = implode("\n", $stockLines);
        }

        // 2. INTENT B: Sales Performance & Revenue (Weekly / Daily / Monthly)
        if (str_contains($normalized, 'penjualan') || str_contains($normalized, 'omzet') || str_contains($normalized, 'omset') || str_contains($normalized, 'pendapatan') || str_contains($normalized, 'transaksi') || str_contains($normalized, 'performa') || str_contains($normalized, 'order')) {
            $timeframeLabel = 'Minggu Ini (7 Hari Terakhir)';
            $dateCondition = "created_at >= DATE_SUB(NOW(), INTERVAL 7 DAY)";

            if (str_contains($normalized, 'hari ini') || str_contains($normalized, 'today')) {
                $timeframeLabel = 'Hari Ini (' . date('d M Y') . ')';
                $dateCondition = "DATE(created_at) = CURDATE()";
            } elseif (str_contains($normalized, 'bulan ini') || str_contains($normalized, 'month')) {
                $timeframeLabel = 'Bulan Ini (' . date('F Y') . ')';
                $dateCondition = "created_at >= DATE_SUB(NOW(), INTERVAL 30 DAY)";
            }

            // Query sales aggregate
            $stmtSales = $this->db->query("
                SELECT 
                    COUNT(*) AS total_orders,
                    COALESCE(SUM(total_amount), 0) AS total_amount,
                    COALESCE(SUM(CASE WHEN payment_status = 'paid' THEN total_amount ELSE 0 END), 0) AS paid_revenue,
                    SUM(CASE WHEN payment_status = 'paid' THEN 1 ELSE 0 END) AS paid_orders,
                    SUM(CASE WHEN order_status = 'completed' THEN 1 ELSE 0 END) AS completed_orders,
                    SUM(CASE WHEN order_status = 'processing' THEN 1 ELSE 0 END) AS processing_orders,
                    SUM(CASE WHEN order_status = 'shipped' THEN 1 ELSE 0 END) AS shipped_orders,
                    SUM(CASE WHEN order_status = 'pending' THEN 1 ELSE 0 END) AS pending_orders,
                    SUM(CASE WHEN order_status = 'cancelled' THEN 1 ELSE 0 END) AS cancelled_orders
                FROM orders
                WHERE {$dateCondition}
            ");
            $salesData = $stmtSales->fetch(PDO::FETCH_ASSOC) ?: [];

            // Query top-selling products in timeframe
            $stmtTop = $this->db->query("
                SELECT oi.product_name_snapshot, SUM(oi.quantity) AS qty_sold, SUM(oi.subtotal) AS total_val
                FROM order_items oi
                JOIN orders o ON oi.order_id = o.id
                WHERE o.{$dateCondition} AND o.payment_status = 'paid'
                GROUP BY oi.product_name_snapshot
                ORDER BY qty_sold DESC
                LIMIT 5
            ");
            $topItems = $stmtTop->fetchAll(PDO::FETCH_ASSOC);

            $salesLines = [
                "[DATA INTERNAL DATABASE: PERFORMA PENJUALAN - PERIODE: {$timeframeLabel}]",
                "- Total Pendapatan Lunas: Rp " . number_format($salesData['paid_revenue'] ?? 0, 0, ',', '.'),
                "- Total Pesanan Masuk: " . ($salesData['total_orders'] ?? 0) . " pesanan",
                "  • Pesanan Lunas / Terbayar: " . ($salesData['paid_orders'] ?? 0),
                "  • Selesai: " . ($salesData['completed_orders'] ?? 0) . ", Diproses: " . ($salesData['processing_orders'] ?? 0) . ", Dikirim: " . ($salesData['shipped_orders'] ?? 0) . ", Menunggu Pembayaran: " . ($salesData['pending_orders'] ?? 0) . ", Dibatalkan: " . ($salesData['cancelled_orders'] ?? 0)
            ];

            if (!empty($topItems)) {
                $salesLines[] = "- Produk Terlaris Periode Ini:";
                foreach ($topItems as $ti) {
                    $salesLines[] = "  * {$ti['product_name_snapshot']} (Terjual {$ti['qty_sold']} pcs - Total Omzet: Rp " . number_format($ti['total_val'], 0, ',', '.') . ")";
                }
            } else {
                $salesLines[] = "- Belum ada item yang lunas terjual pada periode ini.";
            }

            $sections[] = implode("\n", $salesLines);
        }

        // 3. INTENT C1: Total Pengguna / User Terdaftar di Database (SELECT COUNT(*) FROM users)
        $isTotalUsersQuery = (
            (str_contains($normalized, 'total') || str_contains($normalized, 'jumlah') || str_contains($normalized, 'berapa') || str_contains($normalized, 'hitung')) &&
            (str_contains($normalized, 'pengguna') || str_contains($normalized, 'user') || str_contains($normalized, 'member') || str_contains($normalized, 'akun'))
        );

        if ($isTotalUsersQuery) {
            $stmtUserCount = $this->db->query("SELECT COUNT(*) FROM users");
            $totalUsers = (int)$stmtUserCount->fetchColumn();

            $sections[] = "[DATA INTERNAL DATABASE: TOTAL PENGGUNA TERDAFTAR]\n"
                . "Konteks: Total pengguna terdaftar saat ini adalah {$totalUsers} orang.";
        }

        // 4. INTENT C2: Identitas Admin (Siapa Saya / Akun Pengguna yang Bertanya)
        if (
            str_contains($normalized, 'siapa saya') || 
            str_contains($normalized, 'siapa aku') || 
            str_contains($normalized, 'siapa nama saya') ||
            str_contains($normalized, 'identitas saya') ||
            str_contains($normalized, 'profil saya') ||
            str_contains($normalized, 'akun saya')
        ) {
            $adminName = $user['name'] ?? ($_SESSION['user_name'] ?? 'Admin');
            $adminRole = ucfirst($user['role'] ?? ($_SESSION['user_role'] ?? 'Admin'));
            $sections[] = "[DATA INTERNAL DATABASE: IDENTITAS PENGGUNA]\n"
                . "Konteks: User yang bertanya adalah {$adminRole} bernama {$adminName}.";
        }

        // 5. INTENT C3: Customer / Pelanggan Unik Belanja Hari Ini atau Periode Tertentu
        if (
            !$isTotalUsersQuery && (
                str_contains($normalized, 'customer') || 
                str_contains($normalized, 'pelanggan') || 
                str_contains($normalized, 'pembeli') || 
                (str_contains($normalized, 'user') && str_contains($normalized, 'belanja')) ||
                (str_contains($normalized, 'berapa') && str_contains($normalized, 'belanja'))
            )
        ) {
            $isToday = str_contains($normalized, 'hari ini') || str_contains($normalized, 'today');
            $dateCondition = $isToday ? "DATE(o.created_at) = CURDATE()" : "o.created_at >= DATE_SUB(NOW(), INTERVAL 7 DAY)";
            $label = $isToday ? "Hari Ini (" . date('d M Y') . ")" : "7 Hari Terakhir";

            $stmtCust = $this->db->query("
                SELECT 
                    COUNT(DISTINCT o.user_id) AS total_unique_customers,
                    COUNT(DISTINCT CASE WHEN o.payment_status = 'paid' THEN o.user_id END) AS paid_unique_customers,
                    COUNT(*) AS total_orders
                FROM orders o
                WHERE {$dateCondition}
            ");
            $custData = $stmtCust->fetch(PDO::FETCH_ASSOC) ?: [];
            $totalCust = (int)($custData['total_unique_customers'] ?? 0);
            $paidCust = (int)($custData['paid_unique_customers'] ?? 0);
            $totalOrders = (int)($custData['total_orders'] ?? 0);

            $custLines = [
                "[DATA INTERNAL DATABASE: JUMLAH CUSTOMER / PEMBELI ({$label})]",
                "- Hari ini ada {$totalCust} customer unik yang berbelanja (dengan total {$totalOrders} transaksi pesanan masuk).",
                "- Customer dengan pesanan terbayar/lunas: {$paidCust} orang."
            ];

            if ($totalCust > 0) {
                $stmtCustDetails = $this->db->query("
                    SELECT DISTINCT u.id, u.name, u.email, o.order_number, o.total_amount, o.payment_status
                    FROM orders o
                    JOIN users u ON o.user_id = u.id
                    WHERE {$dateCondition}
                    ORDER BY o.id DESC
                    LIMIT 5
                ");
                $details = $stmtCustDetails->fetchAll(PDO::FETCH_ASSOC);
                if (!empty($details)) {
                    $custLines[] = "- Rincian Pelanggan Terkait:";
                    foreach ($details as $d) {
                        $custLines[] = "  • {$d['name']} ({$d['email']}) | No. Pesanan: {$d['order_number']} | Total: Rp " . number_format($d['total_amount'], 0, ',', '.') . " | Status Bayar: {$d['payment_status']}";
                    }
                }
            }

            $sections[] = implode("\n", $custLines);
        }

        // 4. INTENT D: Recent Orders / Specific Order lookup
        if (str_contains($normalized, 'pesanan') || str_contains($normalized, 'order') || preg_match('/NNA-[0-9]{8}/i', $rawMessage)) {
            $stmtRecentOrders = $this->db->query("
                SELECT order_number, total_amount, payment_status, order_status, created_at
                FROM orders ORDER BY id DESC LIMIT 5
            ");
            $recent = $stmtRecentOrders->fetchAll(PDO::FETCH_ASSOC);
            $orderLines = ["[DATA INTERNAL DATABASE: PESANAN TERBARU]"];
            foreach ($recent as $ro) {
                $orderLines[] = "- {$ro['order_number']} | Rp " . number_format($ro['total_amount'], 0, ',', '.') . " | Bayar: {$ro['payment_status']} | Status: {$ro['order_status']} | Waktu: {$ro['created_at']}";
            }
            $sections[] = implode("\n", $orderLines);
        }

        // 5. FALLBACK / GENERAL STORE SNAPSHOT (Always include general factual numbers)
        $summary = $this->productService->getSummary();
        $revSummary = $this->orderService->getAdminRevenueSummary();

        // Ambil metrik pembeli hari ini untuk ringkasan umum
        $stmtCustDaily = $this->db->query("
            SELECT 
                COUNT(DISTINCT user_id) AS total_customers_today,
                COUNT(DISTINCT CASE WHEN payment_status = 'paid' THEN user_id END) AS paid_customers_today
            FROM orders 
            WHERE DATE(created_at) = CURDATE()
        ");
        $custDaily = $stmtCustDaily->fetch(PDO::FETCH_ASSOC) ?: [];
        $uniqueCustToday = (int)($custDaily['total_customers_today'] ?? 0);
        $paidCustToday = (int)($custDaily['paid_customers_today'] ?? 0);

        $fallbackOverview = "[DATA INTERNAL DATABASE: RINGKASAN UMUM TOKO REAL-TIME]\n"
            . "- Hari ini ada {$uniqueCustToday} customer unik yang berbelanja ({$paidCustToday} customer terbayar/lunas)\n"
            . "- Total Model Produk: {$summary['total_products']} model ({$summary['active_products']} aktif, {$summary['inactive_products']} nonaktif)\n"
            . "- Total Stok Fisik Tersedia: {$summary['total_stock_units']} unit\n"
            . "- Produk Stok Menipis (<= 5 unit): {$summary['low_stock_products']} model\n"
            . "- Produk Stok Habis: {$summary['out_of_stock_products']} model\n"
            . "- Total Omzet Sepanjang Masa: {$revSummary['total_revenue_formatted']}\n"
            . "- Omzet Lunas Hari Ini: {$revSummary['today_revenue_formatted']}\n"
            . "- Total Semua Pesanan: {$revSummary['total_orders']} pesanan";

        $sections[] = $fallbackOverview;

        return implode("\n\n", $sections);
    }

    /**
     * Customer Catalog Grounding Bridge
     * Detects customer intent (promos, specific products, price, stock) and queries only public catalog tables (products, categories, coupons)
     * Strictly enforces data privacy by never reading or injecting orders, users, or sensitive store data.
     */
    private function buildDynamicCustomerGroundingContext(string $rawMessage, string $normalized): string {
        // 0. INTENT: Tanya Total Produk / Seluruh Katalog Toko (Token Saver Optimization)
        if (
            str_contains($normalized, 'seluruh') ||
            str_contains($normalized, 'semua produk') ||
            str_contains($normalized, 'total produk') ||
            str_contains($normalized, 'jumlah produk') ||
            str_contains($normalized, 'banyak produk') ||
            str_contains($normalized, 'katalog lengkap') ||
            str_contains($normalized, 'daftar produk') ||
            preg_match('/(?:ada\s+)?berapa\s+(?:seluruh\s+|semua\s+|total\s+)?(?:jumlah\s+)?(?:produk|barang|item|koleksi)/i', $normalized)
        ) {
            $stmtCount = $this->db->query("SELECT COUNT(*) FROM products WHERE status = 'active'");
            $total = (int)$stmtCount->fetchColumn();

            $stmtCats = $this->db->query("SELECT name FROM categories WHERE status = 'active' ORDER BY id ASC LIMIT 3");
            $sampleCats = implode(', ', $stmtCats->fetchAll(PDO::FETCH_COLUMN) ?: ['Aksesoris']);

            return "Data: Total produk aktif saat ini ada {$total} item dari berbagai kategori (seperti {$sampleCats}). JANGAN sebutkan nama produk satu per satu. Arahkan pelanggan untuk melihat kategori di menu atau gunakan kolom pencarian website.";
        }

        // 1. INTENT A: Promo, Voucher, Diskon, Kupon
        if (
            str_contains($normalized, 'promo') ||
            str_contains($normalized, 'diskon') ||
            str_contains($normalized, 'kupon') ||
            str_contains($normalized, 'voucher') ||
            str_contains($normalized, 'potongan') ||
            str_contains($normalized, 'cashback')
        ) {
            $stmt = $this->db->query("
                SELECT code, discount_type, discount_value, minimum_purchase, maximum_discount, end_at
                FROM coupons
                WHERE status = 'active' AND (end_at IS NULL OR end_at >= NOW())
                ORDER BY id ASC
                LIMIT 5
            ");
            $coupons = $stmt->fetchAll(PDO::FETCH_ASSOC);

            $text = "[INFO VOUCHER & PROMO AKTIF HARI INI]\n";
            if (empty($coupons)) {
                $text .= "- Saat ini belum ada kode voucher kupon baru. Namun banyak produk yang sedang diskon langsung di katalog!\n";
            } else {
                foreach ($coupons as $c) {
                    $potongan = $c['discount_type'] === 'percentage' 
                        ? "Diskon {$c['discount_value']}% (Maks. Rp " . number_format($c['maximum_discount'], 0, ',', '.') . ")"
                        : "Potongan Langsung Rp " . number_format($c['discount_value'], 0, ',', '.');
                    $minBelanja = 'Rp ' . number_format($c['minimum_purchase'], 0, ',', '.');
                    $text .= "- Kode Kupon: \"{$c['code']}\" ({$potongan}, Min. Belanja: {$minBelanja})\n";
                }
            }

            // Produk flash sale / diskon langsung
            $stmtDisc = $this->db->query("
                SELECT name, price, discount_price, stock
                FROM products
                WHERE status = 'active' AND discount_price IS NOT NULL AND discount_price > 0 AND discount_price < price
                ORDER BY (price - discount_price) DESC
                LIMIT 3
            ");
            $discProds = $stmtDisc->fetchAll(PDO::FETCH_ASSOC);
            if (!empty($discProds)) {
                $text .= "\n[PRODUK FLASH SALE / DISKON LANGSUNG]:\n";
                foreach ($discProds as $dp) {
                    $hemat = $dp['price'] - $dp['discount_price'];
                    $text .= "- {$dp['name']}: Rp " . number_format($dp['discount_price'], 0, ',', '.') . " (Harga normal: Rp " . number_format($dp['price'], 0, ',', '.') . ", Hemat Rp " . number_format($hemat, 0, ',', '.') . ", Stok: {$dp['stock']} pcs)\n";
                }
            }

            return $text;
        }

        // 2. INTENT B: Cek Harga, Stok, atau Spesifik Aksesoris
        $stopWords = ['apakah', 'berapa', 'harga', 'stok', 'stoknya', 'ada', 'masih', 'yang', 'ini', 'itu', 'kak', 'min', 'mau', 'tanya', 'dong', 'bisa', 'tolong', 'di', 'ke', 'dari', 'ya'];
        $words = preg_split('/\s+/', preg_replace('/[^\p{L}\p{N}\s]/u', ' ', $normalized));
        $keywords = array_values(array_filter($words, function($w) use ($stopWords) {
            return mb_strlen($w) >= 3 && !in_array($w, $stopWords);
        }));

        if (!empty($keywords)) {
            $clauses = [];
            $params = [];
            foreach ($keywords as $kw) {
                $clauses[] = "(p.name LIKE ? OR p.description LIKE ? OR c.name LIKE ?)";
                $params[] = "%{$kw}%";
                $params[] = "%{$kw}%";
                $params[] = "%{$kw}%";
            }

            $whereSql = implode(' OR ', $clauses);
            $sql = "
                SELECT p.id, p.name, p.sku, p.price, p.discount_price, p.stock, COALESCE(c.name, 'Aksesoris') AS category_name
                FROM products p
                LEFT JOIN categories c ON p.category_id = c.id
                WHERE p.status = 'active' AND ({$whereSql})
                ORDER BY (CASE WHEN p.stock > 0 THEN 0 ELSE 1 END) ASC, p.sales_count DESC
                LIMIT 5
            ";

            $stmt = $this->db->prepare($sql);
            $stmt->execute($params);
            $products = $stmt->fetchAll(PDO::FETCH_ASSOC);

            if (!empty($products)) {
                $text = "[DATA PRODUK DITEMUKAN DI DATABASE]:\n";
                foreach ($products as $p) {
                    $priceText = 'Rp ' . number_format($p['price'], 0, ',', '.');
                    if (!empty($p['discount_price']) && $p['discount_price'] > 0 && $p['discount_price'] < $p['price']) {
                        $priceText = 'Rp ' . number_format($p['discount_price'], 0, ',', '.') . " (Diskon dari Rp " . number_format($p['price'], 0, ',', '.') . ")";
                    }
                    $stockText = $p['stock'] > 0 ? "Tersedia ({$p['stock']} pcs siap kirim)" : "Stok Habis";
                    $text .= "- {$p['name']} [Kategori: {$p['category_name']}] | Harga: {$priceText} | Status Stok: {$stockText}\n";
                }
                return $text;
            }
        }

        // 3. INTENT C / FALLBACK: Rekomendasi Koleksi Terpopuler & Kebijakan Toko
        $stmtPop = $this->db->query("
            SELECT p.name, p.price, p.discount_price, p.stock, COALESCE(c.name, 'Aksesoris') AS category_name
            FROM products p
            LEFT JOIN categories c ON p.category_id = c.id
            WHERE p.status = 'active' AND p.stock > 0
            ORDER BY p.sales_count DESC
            LIMIT 4
        ");
        $popular = $stmtPop->fetchAll(PDO::FETCH_ASSOC);

        $text = "[REKOMENDASI KOLEKSI TERPOPULER SAAT INI]:\n";
        foreach ($popular as $p) {
            $price = !empty($p['discount_price']) && $p['discount_price'] < $p['price'] ? $p['discount_price'] : $p['price'];
            $text .= "- {$p['name']} ({$p['category_name']}) - Rp " . number_format($price, 0, ',', '.') . " (Stok: {$p['stock']} pcs)\n";
        }
        $text .= "\n[KEBIJAKAN TOKO]: Pengiriman via SiCepat, JNE, J&T. Pembayaran QRIS, Virtual Account, & Transfer Bank.";

        return $text;
    }

    /**
     * Query active LLM provider (Gemini / OpenAI) with database grounding & usage logging
     */
    private function queryLLMProvider(string $rawMessage, string $normalized, array &$context, ?array $user): ?array {
        $activeProvider = $this->aiConfig->getActiveProvider();
        if (!$activeProvider || empty($this->apiKey)) {
            return null;
        }

        $activeModel = $this->aiConfig->getDefaultModel();
        if (!$activeModel) {
            return null;
        }

        // 1. Guardrail: Max message length limit
        $maxMsgLen = (int)$this->aiConfig->getSetting('ai_max_message_length', 1000);
        if (mb_strlen($rawMessage, 'UTF-8') > $maxMsgLen) {
            return [
                'success' => true,
                'reply' => "Pesan kamu terlalu panjang (maksimal {$maxMsgLen} karakter). Mohon persingkat pertanyaanmu agar aku bisa membantu dengan lebih baik ya! 😊",
                'products' => [],
                'suggestions' => $this->getDefaultSuggestions($user['role'] ?? 'public'),
                'provider' => 'system'
            ];
        }

        $isAdmin = isset($user['role']) && $user['role'] === 'admin';

        if ($isAdmin) {
            // ADMIN COPILOT GROUNDING
            $summary = $this->productService->getSummary();
            $summaryText = $this->productService->formatSummaryText($summary);

            $activeProducts = $this->productService->getProductsByStatus('active', 25);
            $catalogLines = [];
            foreach ($activeProducts as $p) {
                $priceStr = 'Rp ' . number_format($p['price'], 0, ',', '.');
                if (!empty($p['discount_price']) && $p['discount_price'] > 0 && $p['discount_price'] < $p['price']) {
                    $priceStr = 'Rp ' . number_format($p['discount_price'], 0, ',', '.') . " (Diskon dari Rp " . number_format($p['price'], 0, ',', '.') . ")";
                }
                $catalogLines[] = "- {$p['name']} [Kategori: {$p['category_name']}] | Harga: {$priceStr} | Stok: {$p['stock']} unit";
            }
            $catalogText = implode("\n", $catalogLines);

            $dynamicInternalData = $this->buildDynamicAdminGroundingContext($rawMessage, $normalized, $user);
            $promptRow = $this->aiConfig->getActivePrompt();
            $baseInstruction = $promptRow ? $promptRow['prompt_content'] : "Kamu adalah NNasa Admin Copilot, asisten AI internal pengelola toko aksesoris nnasa_ca.";

            $adminName = $user['name'] ?? ($_SESSION['nama'] ?? ($_SESSION['user_name'] ?? null));
            $adminRole = strtolower(trim((string)($user['role'] ?? ($_SESSION['role'] ?? ($_SESSION['user_role'] ?? 'admin')))));

            if (!empty($adminName) && ($adminRole === 'admin' || $adminRole === 'staff')) {
                $userSessionContext = "Konteks Internal: Kamu sedang berbicara dengan Admin toko atas nama {$adminName}.";
                $greetingInstruction = "Gunakan panggilan yang sesuai (Sapaan 'Admin' untuk admin, contoh: 'Halo Admin {$adminName}').";
            } elseif (!empty($adminName) && $adminRole === 'customer') {
                $userSessionContext = "Konteks Internal: Kamu sedang berbicara dengan Customer setia kami atas nama {$adminName}.";
                $greetingInstruction = "Gunakan panggilan yang sesuai (Sapaan 'Kak' untuk Customer, contoh: 'Halo Kak {$adminName}').";
            } else {
                $userSessionContext = "Konteks Internal: Pengguna saat ini belum login (Pengunjung/Guest).";
                $greetingInstruction = "Gunakan sapaan netral. DILARANG berhalusinasi atau menebak nama jika Konteks Internal kosong (belum login).";
            }

            $groundedInstruction = $baseInstruction . "\n\n"
                . "=== IDENTITAS PENGGUNA (SESI LOGIN) ===\n"
                . $userSessionContext . "\n\n"
                . "=== Data Internal Saat Ini (DATABASE REAL-TIME SISTEM) ===\n"
                . $dynamicInternalData . "\n\n"
                . "=== DATA RESMI TOKO SAAT INI ===\n"
                . $summaryText . "\n\n"
                . "=== KATALOG PRODUK AKTIF RESMI ===\n"
                . $catalogText . "\n\n"
                . "=== ATURAN KETAT SISTEM (WAJIB DIPATUHI) ===\n"
                . "1. Jika ditanya 'Siapa saya?', jawablah sesuai dengan Konteks Internal yang diberikan (contoh: 'Anda adalah Admin toko atas nama [Nama]' atau 'Anda adalah Customer kami atas nama [Nama]').\n"
                . "2. Gunakan panggilan yang sesuai (Sapaan 'Kak' untuk Customer, dan 'Admin' untuk admin). {$greetingInstruction}\n"
                . "3. DILARANG berhalusinasi atau menebak nama jika Konteks Internal kosong (belum login).\n"
                . "4. DILARANG memberikan penjelasan panjang lebar, ceramah, atau basa-basi.\n"
                . "5. Jawab maksimal dalam 1 hingga 2 kalimat pendek saja. Langsung ke intinya (to the point).\n"
                . "6. Jika ditanya total pengguna, sebutkan saja angkanya berdasarkan data internal di atas.\n"
                . "7. Faktual: Gunakan data resmi dan data internal di atas secara akurat tanpa mengarang.";
        } else {
            // CUSTOMER SHOPPING ASSISTANT GROUNDING (Strictly public catalog and promos only)
            $dynamicCustomerData = $this->buildDynamicCustomerGroundingContext($rawMessage, $normalized);

            $customerName = $user['name'] ?? ($_SESSION['nama'] ?? ($_SESSION['user_name'] ?? null));
            $customerRole = strtolower(trim((string)($user['role'] ?? ($_SESSION['role'] ?? ($_SESSION['user_role'] ?? 'guest')))));

            if (!empty($customerName) && $customerRole === 'customer') {
                $userSessionContext = "Konteks Internal: Kamu sedang berbicara dengan Customer setia kami atas nama {$customerName}.";
                $greetingRule = "Gunakan panggilan yang sesuai (Sapaan 'Kak' untuk Customer, contoh: 'Halo Kak {$customerName}').";
            } elseif (!empty($customerName) && $customerRole === 'admin') {
                $userSessionContext = "Konteks Internal: Kamu sedang berbicara dengan Admin toko atas nama {$customerName}.";
                $greetingRule = "Gunakan panggilan yang sesuai (Sapaan 'Admin' untuk admin, contoh: 'Halo Admin {$customerName}').";
            } else {
                $userSessionContext = "Konteks Internal: Pengguna saat ini belum login (Pengunjung/Guest).";
                $greetingRule = "Sapa dengan panggilan ramah umum 'Kak'. DILARANG berhalusinasi atau menebak nama jika Konteks Internal kosong (belum login).";
            }

            $groundedInstruction = <<<PROMPT
Kamu adalah NNasa AI, asisten belanja resmi toko aksesoris "nnasa_ca".
Gaya bicara: Ramah, santun, anggun, dan SANGAT SINGKAT (efisien token).

=== IDENTITAS PENGGUNA (SESI LOGIN) ===
{$userSessionContext}
=======================================

=== DATA RESMI KATALOG (DATABASE REAL-TIME) ===
{$dynamicCustomerData}
==============================================

ATURAN KETAT EFISIENSI BALASAN, IDENTITAS & SAPAAN:
1. Jika ditanya 'Siapa saya?', jawablah sesuai dengan Konteks Internal yang diberikan (contoh: 'Anda adalah Customer kami atas nama [Nama]' atau 'Anda adalah Admin toko atas nama [Nama]'). Jika Konteks Internal kosong/belum login, beritahukan bahwa pengguna belum login sebagai pengunjung toko.
2. Gunakan panggilan yang sesuai (Sapaan 'Kak' untuk Customer, dan 'Admin' untuk admin). {$greetingRule}
3. DILARANG berhalusinasi atau menebak nama jika Konteks Internal kosong (belum login).
4. BATAS PANJANG: Jawab MAKSIMAL dalam 2-3 kalimat pendek yang ramah. Dilarang keras membuat paragraf panjang atau bertele-tele.
5. BATAS PRODUK: Dilarang keras menyebutkan lebih dari 3 nama produk dalam satu balasan.
6. JIKA DITANYA TOTAL ATAU SELURUH PRODUK: Sebutkan HANYA angka total produk yang ada di Data di atas, lalu segera arahkan pelanggan untuk menggunakan fitur pencarian di bagian atas website atau melihat menu kategori. DILARANG membuat daftar produk satu per satu!
7. FAKTUAL: Jawab HANYA berdasarkan Data Resmi di atas. Jangan mengarang harga, stok, atau promo yang tidak tercantum.
PROMPT;
        }

        // Retrieve model parameters
        $params = $activeModel['params'] ?? [];
        $params['timeout_seconds'] = !empty($activeModel['timeout_seconds']) && (int)$activeModel['timeout_seconds'] >= 20 ? (int)$activeModel['timeout_seconds'] : 75;
        // Efisiensi biaya & pencegahan ceramah: Customer max 180 token, Admin dibatasi 200 token
        $params['max_output_tokens'] = $isAdmin ? 200 : 180;

        $adapter = $this->aiConfig->getAdapter($activeProvider['provider_name'], $this->apiKey);
        if (!$adapter) {
            return null;
        }

        // 5. Execute generation
        $res = $adapter->generateContent(
            $rawMessage,
            $groundedInstruction,
            $activeModel['model_name'],
            $params,
            $this->apiKey
        );

        if ($res['success'] && !empty($res['reply'])) {
            // Estimate cost ($0.00000015 per token approx)
            $inputTokens = $res['input_tokens'] ?? 0;
            $outputTokens = $res['output_tokens'] ?? 0;
            $estCost = ($inputTokens * 0.00000015) + ($outputTokens * 0.0000006);

            $this->aiConfig->logUsage([
                'provider_id' => $activeProvider['id'],
                'model_id' => $activeModel['id'],
                'user_id' => $user['id'] ?? null,
                'request_status' => 'success',
                'input_tokens' => $inputTokens,
                'output_tokens' => $outputTokens,
                'latency_ms' => $res['latency_ms'] ?? 0,
                'estimated_cost' => $estCost,
                'error_code' => null
            ]);

            $matchedProducts = $this->extractProductsFromText($res['reply'] . ' ' . $rawMessage);
            return [
                'success' => true,
                'reply' => trim($res['reply']),
                'products' => $matchedProducts,
                'suggestions' => $this->getDefaultSuggestions($user['role'] ?? 'public'),
                'provider' => $activeProvider['provider_name'],
                'model' => $activeModel['model_name'],
                'latency_ms' => $res['latency_ms'] ?? 0
            ];
        } else {
            // Log failure
            $this->aiConfig->logUsage([
                'provider_id' => $activeProvider['id'],
                'model_id' => $activeModel['id'],
                'user_id' => $user['id'] ?? null,
                'request_status' => 'failed',
                'input_tokens' => 0,
                'output_tokens' => 0,
                'latency_ms' => $res['latency_ms'] ?? 0,
                'estimated_cost' => 0,
                'error_code' => $res['error'] ?? 'API_ERROR'
            ]);
        }
        return null;
    }

    /**
     * Extracts active products from text mentions for rich cards preview
     */
    private function extractProductsFromText(string $text): array {
        $activeProducts = $this->productService->getProductsByStatus('active', 30);
        $matched = [];
        $lowerText = mb_strtolower($text, 'UTF-8');

        foreach ($activeProducts as $p) {
            $pName = mb_strtolower($p['name'], 'UTF-8');
            $pSku = mb_strtolower($p['sku'], 'UTF-8');

            if (str_contains($lowerText, $pName) || str_contains($lowerText, $pSku)) {
                $matched[$p['id']] = $p;
            } else {
                $words = array_filter(explode(' ', $pName), fn($w) => mb_strlen($w) > 4);
                $hitCount = 0;
                foreach ($words as $w) {
                    if (str_contains($lowerText, $w)) {
                        $hitCount++;
                    }
                }
                if ($hitCount >= 2) {
                    $matched[$p['id']] = $p;
                }
            }
        }

        return array_values(array_slice($matched, 0, 4));
    }

    /**
     * Checks if a user query requires deterministic database computation / system lookup
     */
    private function isDeterministicQuery(string $t, array $context): bool {
        return $this->isGreeting($t)
            || $this->isThankYou($t)
            || $this->isIdentityQuery($t)
            || $this->isOrderInquiry($t)
            || $this->isRevenueOrSalesQuery($t)
            || $this->isProductSummaryQuery($t)
            || $this->isActiveOrInactiveQuery($t)
            || $this->isLowOrOutOfStockQuery($t)
            || $this->isStockExtremesQuery($t)
            || $this->isTotalUnitsStockQuery($t)
            || $this->isIncompleteDataQuery($t)
            || $this->isCategoryBreakdownQuery($t)
            || $this->isSpecificStockQuery($t)
            || $this->isWebsiteGuideQuery($t)
            || $this->isDrillDownOrFollowUp($t, $context);
    }

    /**
     * Intent Helper Functions
     */
    private function isGreeting(string $t): bool {
        return in_array($t, ['halo', 'hai', 'hello', 'hi', 'hey', 'pagi', 'siang', 'sore', 'malam', 'assalamualaikum', 'ping', 'tes', 'test']) ||
               preg_match('/^(selamat\s+(pagi|siang|sore|malam)|halo\s*(kak|admin|nnasa)?|hai\s*(kak|admin|nnasa)?)$/i', $t);
    }

    private function isThankYou(string $t): bool {
        return in_array($t, ['makasih', 'terima kasih', 'thanks', 'thank you', 'thx', 'tengkyu', 'siap makasih', 'oke makasih']);
    }

    private function isIdentityQuery(string $t): bool {
        return str_contains($t, 'siapa kamu') || str_contains($t, 'kamu siapa') || str_contains($t, 'apa itu nnasa ai') || str_contains($t, 'kamu ai apa');
    }

    private function isDrillDownOrFollowUp(string $t, array $context): bool {
        if (str_contains($t, 'status') || str_contains($t, 'aktif') || str_contains($t, 'aktip') || 
            str_contains($t, 'nonaktif') || str_contains($t, 'tidak aktif') || str_contains($t, 'baru') || 
            str_contains($t, 'kategori') || str_contains($t, 'kata gori') || str_contains($t, 'katagori') ||
            str_contains($t, 'terlaris') || str_contains($t, 'laris') || str_contains($t, 'fitur') ||
            str_contains($t, 'produk') || str_contains($t, 'pesanan') || str_contains($t, 'order') ||
            str_contains($t, 'stok') || str_contains($t, 'omzet') || str_contains($t, 'pendapatan') ||
            str_contains($t, 'berapa') || str_contains($t, 'total') || str_contains($t, 'jumlah')) {
            return false;
        }

        return preg_match('/\b(kalau|kalo|tampilkan semuanya|tampilkan semua|lihat semuanya|lihat semua|semuanya|daftarnya|listnya|warna|berapa harganya|brp harganya|habis saja|yang habis)\b/i', $t);
    }

    private function isProductSummaryQuery(string $t): bool {
        return str_contains($t, 'ringkasan produk') ||
               str_contains($t, 'kondisi produk') ||
               str_contains($t, 'rekap produk') ||
               str_contains($t, 'status produk') ||
               (str_contains($t, 'berapa') && str_contains($t, 'total produk')) ||
               (str_contains($t, 'ada berapa') && str_contains($t, 'produk di database')) ||
               (str_contains($t, 'total produk') && str_contains($t, 'database')) ||
               $t === 'ringkasan' || $t === 'ringkasan produk';
    }

    private function isActiveOrInactiveQuery(string $t): bool {
        return (str_contains($t, 'aktif') || str_contains($t, 'aktip') || str_contains($t, 'nonaktif') || str_contains($t, 'tidak aktif')) &&
               (str_contains($t, 'berapa') || str_contains($t, 'tampilkan') || str_contains($t, 'produk') || str_contains($t, 'daftar'));
    }

    private function isLowOrOutOfStockQuery(string $t): bool {
        return str_contains($t, 'stok habis') || str_contains($t, 'habis') || str_contains($t, 'kosong') ||
               str_contains($t, 'menipis') || str_contains($t, 'hampir habis') || str_contains($t, 'sisa sedikit') ||
               (str_contains($t, 'stok') && (str_contains($t, 'kurang') || str_contains($t, 'bawah') || str_contains($t, 'sedikit') || str_contains($t, 'sisa') || preg_match('/stok[^\d]*[<]\s*\d+/i', $t)));
    }

    private function isStockExtremesQuery(string $t): bool {
        return (str_contains($t, 'stok') || str_contains($t, 'jumlah')) &&
               (str_contains($t, 'paling sedikit') || str_contains($t, 'terendah') || str_contains($t, 'paling banyak') || str_contains($t, 'terbanyak'));
    }

    private function isTotalUnitsStockQuery(string $t): bool {
        return str_contains($t, 'total stok seluruh') ||
               str_contains($t, 'total stok fisik') ||
               str_contains($t, 'total unit stok') ||
               str_contains($t, 'berapa total stok');
    }

    private function isIncompleteDataQuery(string $t): bool {
        return str_contains($t, 'belum lengkap') || str_contains($t, 'data kurang') || str_contains($t, 'tidak lengkap') || str_contains($t, 'audit data');
    }

    private function isCategoryBreakdownQuery(string $t): bool {
        return (str_contains($t, 'kategori') && (str_contains($t, 'berapa') || str_contains($t, 'jumlah') || str_contains($t, 'distribusi') || str_contains($t, 'rincian')));
    }

    private function isSpecificStockQuery(string $t): bool {
        return (str_contains($t, 'stok') || str_contains($t, 'stock') || str_contains($t, 'tersedia') || str_contains($t, 'ready')) &&
               !str_contains($t, 'kurang') && !str_contains($t, 'bawah') && !str_contains($t, 'menipis') &&
               !str_contains($t, 'total') && !str_contains($t, 'semua') && !str_contains($t, 'ringkasan');
    }

    private function isOrderInquiry(string $t): bool {
        return str_contains($t, 'pesanan') || str_contains($t, 'order') || preg_match('/NNA-[0-9]{8}/i', $t);
    }

    private function isRevenueOrSalesQuery(string $t): bool {
        return str_contains($t, 'omzet') || str_contains($t, 'pendapatan') || str_contains($t, 'keuangan') ||
               str_contains($t, 'omset') || str_contains($t, 'performa penjualan') ||
               (str_contains($t, 'penjualan') && (str_contains($t, 'ringkasan') || str_contains($t, 'minggu') || str_contains($t, 'hari') || str_contains($t, 'bulan') || str_contains($t, 'laporan') || str_contains($t, 'rekap') || str_contains($t, 'performa')));
    }

    private function isWebsiteGuideQuery(string $t): bool {
        return str_contains($t, 'cara') || str_contains($t, 'gimana') || str_contains($t, 'bagaimana') ||
               str_contains($t, 'bayar') || str_contains($t, 'kirim') || str_contains($t, 'ongkir') ||
               str_contains($t, 'resi') || str_contains($t, 'lacak') || str_contains($t, 'wa') ||
               str_contains($t, 'whatsapp') || str_contains($t, 'admin') || str_contains($t, 'tentang');
    }

    private function isCouponQuery(string $t): bool {
        return str_contains($t, 'kupon') || str_contains($t, 'voucher') || str_contains($t, 'promo') ||
               str_contains($t, 'diskon') || str_contains($t, 'potongan') || str_contains($t, 'kode');
    }

    private function isPriceFilterQuery(string $t): bool {
        if (str_contains($t, 'stok') || str_contains($t, 'stock') || str_contains($t, 'unit') || str_contains($t, 'pcs') || str_contains($t, 'sisa')) {
            return false;
        }
        return str_contains($t, 'murah') || str_contains($t, 'terjangkau') || str_contains($t, 'hemat') ||
               str_contains($t, 'di bawah') || str_contains($t, 'dibawah') || str_contains($t, 'kurang dari') ||
               str_contains($t, 'budget') || str_contains($t, 'paling murah');
    }

    private function isRecommendationQuery(string $t): bool {
        return str_contains($t, 'rekomendasi') || str_contains($t, 'saran') || str_contains($t, 'laris') ||
               str_contains($t, 'terlaris') || str_contains($t, 'best seller') || str_contains($t, 'kado') ||
               str_contains($t, 'hadiah') || str_contains($t, 'hampers') || str_contains($t, 'terbaru') ||
               str_contains($t, 'baru') || str_contains($t, 'populer');
    }

    private function getDefaultSuggestions(string $role): array {
        if ($role === 'admin' || $role === 'staff') {
            return [
                '📊 Ringkasan Produk',
                '📦 Total Stok Fisik',
                '⚠️ Stok Menipis',
                '💰 Ringkasan Omzet',
                '❌ Produk Stok Habis',
                '💡 Peta Fitur Admin'
            ];
        }

        return [
            '📊 Ringkasan Produk',
            '💎 Aksesoris Murah',
            '🌸 Rekomendasi Kalung',
            '✨ Cek Stok Jedai',
            '📦 Cara Membeli',
            '🏷️ Info Promo NNASANEW'
        ];
    }

    private function getBaseUrl(): string {
        return defined('BASE_URL') ? BASE_URL : '/toko/';
    }

    /**
     * Text Normalization & Typo correction
     */
    private function normalizeText(string $str): string {
        $str = mb_strtolower($str, 'UTF-8');
        $str = preg_replace('/[^\p{L}\p{N}\s\-\.]/u', ' ', $str);
        $str = preg_replace('/\s+/', ' ', trim($str));

        // Phrase replacements
        $str = str_replace(['kata gori', 'katagori', 'kategori2'], 'kategori', $str);

        $typos = [
            'rekomendasiin' => 'rekomendasi',
            'recomended' => 'rekomendasi',
            'rekomend' => 'rekomendasi',
            'murahh' => 'murah',
            'mura' => 'murah',
            'ongkrrr' => 'ongkir',
            'ongkrr' => 'ongkir',
            'ongkiir' => 'ongkir',
            'jepitan' => 'jepit',
            'antingg' => 'anting',
            'cincinn' => 'cincin',
            'gelangg' => 'gelang',
            'hrg' => 'harga',
            'brp' => 'berapa',
            'kalo' => 'kalau',
            'gmn' => 'gimana',
            'dimana' => 'di mana',
            'brapa' => 'berapa',
            'dftr' => 'daftar',
            'chekout' => 'checkout',
            'cekout' => 'checkout',
            'byar' => 'bayar',
            'pembayarn' => 'pembayaran',
            'aktip' => 'aktif',
            'pesenan' => 'pesanan',
            'ordran' => 'order',
            'ordr' => 'order'
        ];

        $words = explode(' ', $str);
        foreach ($words as &$w) {
            if (isset($typos[$w])) {
                $w = $typos[$w];
            }
        }

        return implode(' ', $words);
    }
}
