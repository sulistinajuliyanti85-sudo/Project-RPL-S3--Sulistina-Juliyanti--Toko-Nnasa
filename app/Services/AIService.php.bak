<?php
/**
 * NNasa AI Assistant Service (Platform-Wide Integration)
 * Store: nnasa_ca Accessories Marketplace
 * 
 * Provides:
 * - Natural Language Understanding (Indonesian slang, typos, intent recognition)
 * - Multi-turn conversational context memory & drill-down filtering
 * - Deep Database Grounding via ProductIntelligenceService & OrderIntelligenceService
 * - Full Platform Feature Navigation via FeatureRegistry
 * - Role-Based Access Control (RBAC) awareness (Public, Customer, Admin)
 * - Anti-hallucination guardrails (only factual store & database data)
 * - Dual Engine: Google Gemini API (if key configured) with seamless fallback to Built-in Intelligent RAG Engine
 */

require_once __DIR__ . '/FeatureRegistry.php';
require_once __DIR__ . '/ProductIntelligenceService.php';
require_once __DIR__ . '/OrderIntelligenceService.php';
require_once dirname(__DIR__) . '/Models/AIConfigModel.php';

class AIService {
    private PDO $db;
    private array $settings = [];
    private ?string $apiKey = null;
    private string $provider = 'builtin';

    private ProductIntelligenceService $productService;
    private OrderIntelligenceService $orderService;
    private AIConfigModel $aiConfig;

    public function __construct(PDO $db) {
        $this->db = $db;
        $this->aiConfig = new AIConfigModel($db);
        $this->productService = new ProductIntelligenceService($db);
        $this->orderService = new OrderIntelligenceService($db);
        $this->loadSettings();
    }

    /**
     * Load settings from database & config
     */
    private function loadSettings(): void {
        try {
            $stmt = $this->db->query("SELECT setting_key, setting_value FROM settings");
            $this->settings = $stmt->fetchAll(PDO::FETCH_KEY_PAIR) ?: [];
        } catch (Exception $e) {
            $this->settings = [];
        }

        // Retrieve active provider and model from AIConfigModel
        $activeProv = $this->aiConfig->getActiveProvider();
        if ($activeProv && !empty($activeProv['id'])) {
            $this->apiKey = $this->aiConfig->getDecryptedApiKey((int)$activeProv['id']);
            $this->provider = !empty($this->apiKey) ? $activeProv['provider_name'] : 'builtin';
        } else {
            $this->apiKey = null;
            $this->provider = 'builtin';
        }
    }

    /**
     * Main conversation processor with user role context
     */
    public function processMessage(string $userMessage, array &$context = [], ?array $user = null): array {
        $trimmed = trim($userMessage);
        $role = $user['role'] ?? 'public';
        $userId = isset($user['id']) ? (int)$user['id'] : null;

        if ($trimmed === '') {
            $welcome = $this->settings['ai_welcome_message'] ?? 'Hai! Selamat datang di nnasa_ca. Aku NNasa AI, asisten virtual resmi yang siap membantu kamu mencari aksesoris, mengecek harga dan ketersediaan produk, serta menjawab pertanyaan tentang toko kami. Ada yang bisa aku bantu?';
            return [
                'success' => true,
                'reply' => $welcome,
                'products' => [],
                'suggestions' => $this->getDefaultSuggestions($role),
                'provider' => $this->provider
            ];
        }

        $normalized = $this->normalizeText($trimmed);

        // 1. Direct Feature Navigation Search Check (instant URL guidance)
        $featureMatch = $this->handleFeatureSearch($normalized, $role);
        if ($featureMatch !== null) {
            return $featureMatch;
        }

        // 2. Deterministic Database Operations (counted with mathematical precision via MySQL PDO)
        if ($this->isDeterministicQuery($normalized, $context)) {
            return $this->processBuiltinEngine($trimmed, $normalized, $context, $user);
        }

        // 3. Conversational, Creative Styling, Gift Advice, or General Inquiries
        // Query active LLM Provider (Gemini / OpenAI) grounded in real database inventory catalog
        $llmResponse = $this->queryLLMProvider($trimmed, $normalized, $context, $user);
        if ($llmResponse !== null) {
            return $llmResponse;
        }

        // 4. Built-in Engine Fallback
        return $this->processBuiltinEngine($trimmed, $normalized, $context, $user);
    }

    /**
     * Built-in Intelligent Engine
     */
    private function processBuiltinEngine(string $original, string $normalized, array &$context, ?array $user = null): array {
        $context['turn_count'] = ($context['turn_count'] ?? 0) + 1;
        $context['history'] = $context['history'] ?? [];
        $role = $user['role'] ?? 'public';
        $userId = isset($user['id']) ? (int)$user['id'] : null;
        $isAdmin = ($role === 'admin' || $role === 'staff');

        // 1. Greetings / Chit-chat
        if ($this->isGreeting($normalized)) {
            $welcome = $this->settings['ai_welcome_message'] ?? 'Hai! Selamat datang di nnasa_ca. Aku NNasa AI, asisten virtual resmi yang siap membantu kamu mencari aksesoris, mengecek harga dan ketersediaan produk, serta menjawab pertanyaan tentang toko kami. Ada yang bisa aku bantu?';
            return [
                'success' => true,
                'reply' => $welcome,
                'products' => [],
                'suggestions' => $this->getDefaultSuggestions($role),
                'provider' => 'builtin'
            ];
        }

        // 2. Thank You / Closing
        if ($this->isThankYou($normalized)) {
            return [
                'success' => true,
                'reply' => 'Sama-sama! Senang bisa membantu kamu. Jangan ragu bertanya lagi jika butuh rekomendasi aksesoris atau informasi lainnya ya! Selamat berbelanja di nnasa_ca 💕',
                'products' => [],
                'suggestions' => ['Lihat Semua Produk', 'Promo & Diskon', 'Hubungi WhatsApp'],
                'provider' => 'builtin'
            ];
        }

        // 3. Identity / Role Query
        if ($this->isIdentityQuery($normalized)) {
            return [
                'success' => true,
                'reply' => "Aku adalah **NNasa AI Assistant**, asisten virtual cerdas terintegrasi resmi dari toko aksesoris online **nnasa_ca**.\n\n"
                         . "Aku terhubung langsung dengan basis data sistem secara real-time untuk:\n"
                         . "💎 Menjawab ketersediaan stok fisik & varian produk\n"
                         . "💰 Menghitung harga diskon & voucher promo\n"
                         . "📦 Melacak status pesanan & nomor resi ekspedisi\n"
                         . "🧭 Memandu penggunaan seluruh fitur website pelanggan & panel admin\n"
                         . "📊 Menyajikan ringkasan statistik produk akurat tanpa halusinasi.",
                'products' => [],
                'suggestions' => ['📊 Ringkasan Produk', '💎 Aksesoris Murah', '📦 Cek Stok Jedai', '💡 Panduan Fitur'],
                'provider' => 'builtin'
            ];
        }

        // 4. Platform Feature Search & Navigation Guide (di mana halaman..., fitur apa...)
        $featureMatch = $this->handleFeatureSearch($normalized, $role);
        if ($featureMatch !== null) {
            return $featureMatch;
        }

        // 5. Multi-Turn Drill-Down / Follow-Up (Section 6)
        // e.g. "Tampilkan semuanya", "Yang stoknya habis saja", "Berapa harganya?", "Kalau warna hitam ada?"
        if ($this->isDrillDownOrFollowUp($normalized, $context)) {
            $drillDownResult = $this->handleDrillDownOrFollowUp($normalized, $context, $isAdmin);
            if ($drillDownResult !== null) {
                return $drillDownResult;
            }
        }

        // 6. Order Lookup (e.g. "cek pesanan NNA-20261014-0001", "status pesanan saya")
        if ($this->isOrderInquiry($normalized)) {
            return $this->handleOrderInquiry($original, $normalized, $context, $user);
        }

        // 7. Admin Revenue & Sales Inquiries (RBAC Guarded)
        if ($this->isRevenueOrSalesQuery($normalized)) {
            return $this->handleRevenueQuery($normalized, $context, $user);
        }

        // 7. Product Summary / Ringkasan Produk (Section 5)
        if ($this->isProductSummaryQuery($normalized)) {
            return $this->handleProductSummaryQuery($context);
        }

        // 8. Active / Inactive Products Count & List
        if ($this->isActiveOrInactiveQuery($normalized)) {
            return $this->handleActiveOrInactiveQuery($normalized, $context);
        }

        // 9. Low Stock / Out of Stock Query
        if ($this->isLowOrOutOfStockQuery($normalized)) {
            return $this->handleLowOrOutOfStockQuery($normalized, $context);
        }

        // 10. Most / Least Stocked Products (Stock Extremes)
        if ($this->isStockExtremesQuery($normalized)) {
            return $this->handleStockExtremesQuery($normalized, $context);
        }

        // 11. Total Stock Units Query
        if ($this->isTotalUnitsStockQuery($normalized)) {
            return $this->handleTotalUnitsStockQuery($context);
        }

        // 12. Incomplete Data Audit Query
        if ($this->isIncompleteDataQuery($normalized)) {
            return $this->handleIncompleteDataQuery($context, $isAdmin);
        }

        // 13. Category Breakdown Query
        if ($this->isCategoryBreakdownQuery($normalized)) {
            return $this->handleCategoryBreakdownQuery($context);
        }

        // 14. Specific Product Stock Check
        if ($this->isSpecificStockQuery($normalized)) {
            $stockResult = $this->handleSpecificStockQuery($normalized, $context);
            if ($stockResult !== null) {
                return $stockResult;
            }
        }

        // 15. Price Filter Query ("murah", "di bawah 50rb", etc.)
        if ($this->isPriceFilterQuery($normalized)) {
            return $this->handlePriceFilterQuery($normalized, $context);
        }

        // 16. Promo & Voucher Inquiries (NNASANEW)
        if ($this->isCouponQuery($normalized)) {
            return $this->handleCouponQuery($normalized, $context);
        }

        // 17. Recommendations / Best Sellers / New Arrivals
        if ($this->isRecommendationQuery($normalized)) {
            return $this->handleRecommendationQuery($normalized, $context);
        }

        // 18. Category Matching
        $categoryMatch = $this->matchCategory($normalized);
        if ($categoryMatch !== null) {
            return $this->handleCategoryQuery($categoryMatch, $normalized, $context);
        }

        // 19. Platform Feature Search & Navigation Guide
        $featureMatch = $this->handleFeatureSearch($normalized, $role);
        if ($featureMatch !== null) {
            return $featureMatch;
        }

        // 20. General Product Search against Database
        $searchResult = $this->handleGeneralProductSearch($normalized, $context);
        if ($searchResult !== null) {
            return $searchResult;
        }

        // 21. Website Guide fallback (cara beli, bayar, dll.)
        if ($this->isWebsiteGuideQuery($normalized)) {
            return $this->handleWebsiteGuideQuery($normalized, $context);
        }

        // Fallback with suggested actions
        return [
            'success' => true,
            'reply' => "Maaf, aku belum menemukan informasi spesifik untuk pertanyaan kamu. Kamu bisa menanyakan koleksi aksesoris kami (seperti jepit rambut, scrunchie, kalung, gelang, anting, cincin), mengecek ketersediaan stok riil, status pesanan, ringkasan produk, atau panduan fitur toko ya. Ada yang ingin kamu cari? 🌸",
            'products' => [],
            'suggestions' => $this->getDefaultSuggestions($role),
            'provider' => 'builtin'
        ];
    }

    /**
     * Multi-Turn Drill-Down / Follow-Up Handler
     */
    private function handleDrillDownOrFollowUp(string $normalized, array &$context, bool $isAdmin = false): ?array {
        $lastTopic = $context['last_topic'] ?? null;
        $lastProducts = $context['last_products'] ?? [];
        $lastFocused = $context['focused_product'] ?? ($lastProducts[0] ?? null);

        // A. Drill-down: "Tampilkan semuanya" / "Lihat semua daftarnya"
        if (preg_match('/\b(tampilkan semuanya|tampilkan semua|lihat semuanya|lihat semua|semuanya|daftarnya|listnya)\b/i', $normalized) && !str_contains($normalized, 'murah')) {
            if ($lastTopic === 'active_products' || ($context['last_filter']['status'] ?? '') === 'active') {
                $products = $this->productService->getProductsByStatus('active', 20);
                $context['last_products'] = $products;
                $context['last_topic'] = 'product_list';

                return [
                    'success' => true,
                    'reply' => "Berikut adalah daftar lengkap produk berstatus **Aktif** yang siap dibeli di nnasa_ca:",
                    'table' => $this->buildProductsTable($products),
                    'products' => array_slice($products, 0, 4),
                    'suggestions' => ['Yang stoknya habis saja', 'Yang stoknya menipis', '📊 Ringkasan Produk'],
                    'provider' => 'builtin'
                ];
            }

            if ($lastTopic === 'inactive_products' || ($context['last_filter']['status'] ?? '') === 'inactive') {
                $products = $this->productService->getProductsByStatus('inactive', 20);
                $context['last_products'] = $products;
                $context['last_topic'] = 'product_list';

                if (empty($products)) {
                    return [
                        'success' => true,
                        'reply' => "Saat ini tidak ada produk yang berstatus nonaktif (draft/archived) di database. Seluruh produk berstatus aktif.",
                        'products' => [],
                        'suggestions' => ['Produk Aktif', '📊 Ringkasan Produk'],
                        'provider' => 'builtin'
                    ];
                }

                return [
                    'success' => true,
                    'reply' => "Berikut adalah daftar produk yang berstatus **Nonaktif (Draft / Diarsipkan)**:",
                    'table' => $this->buildProductsTable($products),
                    'products' => [],
                    'suggestions' => ['Produk Aktif', '📊 Ringkasan Produk'],
                    'provider' => 'builtin'
                ];
            }
        }

        // B. Drill-down: "Yang stoknya habis saja" / "yang habis"
        if (preg_match('/\b(yang|hanya)?\s*(stok(nya)?\s*habis|habis\s*saja|kosong)\b/i', $normalized)) {
            $products = $this->productService->getProductsByStatus('out_of_stock', 20);
            $context['last_products'] = $products;
            $context['last_topic'] = 'out_of_stock_list';

            if (empty($products)) {
                return [
                    'success' => true,
                    'reply' => "Tidak ada produk aktif yang kehabisan stok! Seluruh produk kami saat ini tersedia dan siap dipesan. 🎉",
                    'products' => [],
                    'suggestions' => ['Produk Aktif', 'Aksesoris Murah', '📊 Ringkasan Produk'],
                    'provider' => 'builtin'
                ];
            }

            return [
                'success' => true,
                'reply' => "Berikut adalah produk yang stoknya saat ini **habis (0 unit)**:",
                'table' => $this->buildProductsTable($products),
                'products' => array_slice($products, 0, 4),
                'suggestions' => ['Yang stoknya menipis', 'Produk Aktif'],
                'provider' => 'builtin'
            ];
        }

        // C. Price inquiry on last product ("Berapa harganya?")
        if (preg_match('/\b(berapa|brp)\s*(harga(nya)?|biaya(nya)?)\b/i', $normalized) ||
            preg_match('/\b(harga(nya)?)\s*(berapa|brp)\b/i', $normalized) ||
            $normalized === 'harganya' || $normalized === 'berapa harganya') {
            
            if ($lastFocused) {
                $p = $this->productService->getProductStock($lastFocused['name']);
                if ($p) {
                    $context['focused_product'] = $p;
                    $priceText = $p['has_discount']
                        ? "Harga diskon untuk **{$p['name']}** adalah **{$p['price_formatted']}** (harga normal: ~~{$p['original_price_formatted']}~~, hemat {$p['discount_percent']}%)."
                        : "Harga untuk **{$p['name']}** adalah **{$p['price_formatted']}**.";

                    if (!empty($p['variants'])) {
                        $variantTexts = [];
                        foreach ($p['variants'] as $v) {
                            $adj = (float)$v['price_adjustment'];
                            $adjText = $adj > 0 ? " (+ " . format_rupiah($adj) . ")" : "";
                            $variantTexts[] = "{$v['variant_name']} **{$v['variant_value']}**: stok {$v['stock']} pcs{$adjText}";
                        }
                        $priceText .= "\n\nPilihan varian:\n- " . implode("\n- ", $variantTexts);
                    }

                    return [
                        'success' => true,
                        'reply' => $priceText,
                        'products' => [$p],
                        'suggestions' => ['Beli Sekarang', 'Cek Stok Produk Ini', 'Cari Aksesoris Lain'],
                        'provider' => 'builtin'
                    ];
                }
            }
        }

        // D. Color / Variant refinement ("Kalau yang warna hitam ada?")
        if (preg_match('/\b(warna|pilihan|motif|model|varian)\b/i', $normalized) ||
            preg_match('/\b(hitam|putih|rose gold|gold|silver|lilac|pastel|beige|pink|sage|nude)\b/i', $normalized)) {

            $colors = [
                'hitam' => ['hitam', 'black', 'onyx'],
                'putih' => ['putih', 'white', 'pearl'],
                'rose gold' => ['rose gold', 'rosegold'],
                'gold' => ['gold', 'emas'],
                'silver' => ['silver', 'perak'],
                'pink' => ['pink', 'blush', 'dusty pink'],
                'lilac' => ['lilac', 'ungu'],
                'nude' => ['nude', 'beige', 'champagne'],
                'sage' => ['sage', 'hijau']
            ];

            $matchedColorKey = null;
            foreach ($colors as $key => $synonyms) {
                foreach ($synonyms as $syn) {
                    if (str_contains($normalized, $syn)) {
                        $matchedColorKey = $key;
                        break 2;
                    }
                }
            }

            if ($matchedColorKey !== null) {
                $foundInLast = [];
                foreach ($lastProducts as $lp) {
                    $detail = $this->productService->getProductStock($lp['name']);
                    if ($detail && !empty($detail['variants'])) {
                        foreach ($detail['variants'] as $v) {
                            foreach ($colors[$matchedColorKey] as $syn) {
                                if (stripos($v['variant_value'], $syn) !== false) {
                                    $detail['matched_variant'] = $v;
                                    $foundInLast[] = $detail;
                                    break 2;
                                }
                            }
                        }
                    }
                }

                if (empty($foundInLast)) {
                    $foundInLast = $this->searchProductsByColor($matchedColorKey, $colors[$matchedColorKey]);
                }

                if (!empty($foundInLast)) {
                    $context['last_products'] = $foundInLast;
                    $context['focused_product'] = $foundInLast[0];
                    $pName = $foundInLast[0]['name'];
                    $vName = $foundInLast[0]['matched_variant']['variant_value'] ?? $matchedColorKey;
                    $vStock = $foundInLast[0]['matched_variant']['stock'] ?? $foundInLast[0]['stock'];
                    $vPrice = $foundInLast[0]['price_formatted'];

                    $reply = "Ada! Untuk varian warna **{$vName}**, tersedia pada **{$pName}** seharga **{$vPrice}** dengan stok tersedia **{$vStock} pcs**.";
                    if (count($foundInLast) > 1) {
                        $reply .= " Kami juga memiliki opsi aksesoris berwarna senada lainnya:";
                    }

                    return [
                        'success' => true,
                        'reply' => $reply,
                        'products' => array_slice($foundInLast, 0, 3),
                        'suggestions' => ['Berapa Harganya?', 'Lihat Detail Produk', 'Aksesoris Lainnya'],
                        'provider' => 'builtin'
                    ];
                } else {
                    return [
                        'success' => true,
                        'reply' => "Mohon maaf, saat ini kami belum memiliki varian warna {$matchedColorKey} untuk koleksi tersebut. Warna yang tersedia di butik kami meliputi Rose Gold, Pearl White, Champagne Beige, dan Blush Pink. Mau aku carikan warna lain? 🌸",
                        'products' => [],
                        'suggestions' => ['Warna Rose Gold', 'Warna Pearl White', 'Koleksi Terpopuler'],
                        'provider' => 'builtin'
                    ];
                }
            }
        }

        return null;
    }

    /**
     * Product Summary Handler (Section 5)
     */
    private function handleProductSummaryQuery(array &$context): array {
        $summary = $this->productService->getSummary();
        $reply = $this->productService->formatSummaryText($summary);

        $context['last_topic'] = 'product_summary';
        $context['last_summary'] = $summary;

        return [
            'success' => true,
            'reply' => $reply,
            'stats_card' => [
                ['label' => 'Total Produk', 'value' => $summary['total_products'] . ' Model', 'icon' => 'bi-box-seam', 'color' => 'primary'],
                ['label' => 'Produk Aktif', 'value' => $summary['active_products'] . ' Model', 'icon' => 'bi-check-circle', 'color' => 'success'],
                ['label' => 'Stok Menipis', 'value' => $summary['low_stock_products'] . ' Model', 'icon' => 'bi-exclamation-triangle', 'color' => 'warning'],
                ['label' => 'Stok Fisik', 'value' => $summary['total_stock_units'] . ' Unit', 'icon' => 'bi-boxes', 'color' => 'info']
            ],
            'products' => [],
            'suggestions' => ['✨ Produk Aktif', '⚠️ Stok Menipis', '❌ Stok Habis', '📦 Total Stok Fisik'],
            'provider' => 'builtin'
        ];
    }

    /**
     * Active or Inactive products handler
     */
    private function handleActiveOrInactiveQuery(string $normalized, array &$context): array {
        $isInactive = str_contains($normalized, 'tidak aktif') || str_contains($normalized, 'nonaktif') || str_contains($normalized, 'draft') || str_contains($normalized, 'arsip');

        if ($isInactive) {
            $summary = $this->productService->getSummary();
            $inactiveCount = $summary['inactive_products'];
            $context['last_topic'] = 'inactive_products';
            $context['last_filter'] = ['status' => 'inactive'];

            if ($inactiveCount === 0) {
                return [
                    'success' => true,
                    'reply' => "Berdasarkan data terkini di database toko:\n\n- Jumlah produk **tidak aktif / nonaktif**: **0 produk**\n\nSaat ini tidak ada produk yang berstatus nonaktif (draft / arsip) di database. Seluruh {$summary['total_products']} model produk yang terdaftar di sistem saat ini berstatus **Aktif** dan siap dipesan.",
                    'products' => [],
                    'suggestions' => ['✨ Produk Aktif', '📊 Ringkasan Produk'],
                    'provider' => 'builtin'
                ];
            } else {
                $products = $this->productService->getProductsByStatus('inactive', 10);
                return [
                    'success' => true,
                    'reply' => "Terdapat **{$inactiveCount} produk** yang berstatus nonaktif/draft di database.",
                    'table' => $this->buildProductsTable($products),
                    'products' => [],
                    'suggestions' => ['Tampilkan semuanya', 'Produk Aktif'],
                    'provider' => 'builtin'
                ];
            }
        } else {
            // Active products query
            $summary = $this->productService->getSummary();
            $activeCount = $summary['active_products'];
            $context['last_topic'] = 'active_products';
            $context['last_filter'] = ['status' => 'active'];

            $wantsList = str_contains($normalized, 'tampilkan') || str_contains($normalized, 'daftar') || str_contains($normalized, 'lihat') || str_contains($normalized, 'list');

            if ($wantsList) {
                $products = $this->productService->getProductsByStatus('active', 20);
                return [
                    'success' => true,
                    'reply' => "Berikut adalah daftar produk berstatus **Aktif** yang tersedia di database nnasa_ca ({$activeCount} model produk):",
                    'table' => $this->buildProductsTable($products),
                    'products' => array_slice($products, 0, 4),
                    'suggestions' => ['Yang stoknya habis saja', 'Yang stoknya menipis', '📊 Ringkasan Produk'],
                    'provider' => 'builtin'
                ];
            }

            return [
                'success' => true,
                'reply' => "Berdasarkan data terbaru di database toko:\n\n- Jumlah produk **aktif**: **{$activeCount} produk** (dengan total {$summary['total_stock_units']} unit stok fisik tersedia).\n\nKamu bisa mengetik **'Tampilkan semuanya'** untuk melihat daftar lengkap produk aktif dalam bentuk tabel!",
                'products' => [],
                'suggestions' => ['Tampilkan semuanya', 'Yang stoknya habis saja', 'Yang stoknya menipis', '📊 Ringkasan Produk'],
                'provider' => 'builtin'
            ];
        }
    }

    /**
     * Low stock or out-of-stock query
     */
    private function handleLowOrOutOfStockQuery(string $normalized, array &$context): array {
        $isOutOfStock = str_contains($normalized, 'habis') || str_contains($normalized, 'kosong');

        if ($isOutOfStock) {
            $products = $this->productService->getProductsByStatus('out_of_stock', 10);
            $count = count($products);
            $context['last_topic'] = 'out_of_stock_list';

            if ($count === 0) {
                return [
                    'success' => true,
                    'reply' => "Kabar baik! Saat ini **tidak ada produk aktif yang stoknya habis (0 produk)** di database. Seluruh katalog aksesoris kami masih memiliki stok dan siap dibeli langsung! 🎉",
                    'products' => [],
                    'suggestions' => ['Produk Aktif', '⚠️ Stok Menipis', '📊 Ringkasan Produk'],
                    'provider' => 'builtin'
                ];
            } else {
                return [
                    'success' => true,
                    'reply' => "Terdapat **{$count} produk** yang stoknya saat ini habis:",
                    'table' => $this->buildProductsTable($products),
                    'products' => $products,
                    'suggestions' => ['Produk Aktif', '📊 Ringkasan Produk'],
                    'provider' => 'builtin'
                ];
            }
        } else {
            // Low stock with dynamic threshold extraction
            $threshold = 5;
            $strictLess = false;
            if (preg_match('/(?:kurang dari|di bawah|dibawah|<)\s*([0-9]+)/i', $normalized, $matches)) {
                $threshold = (int)$matches[1];
                $strictLess = true;
            } elseif (preg_match('/(?:sisa|menipis)\s*([0-9]+)/i', $normalized, $matches)) {
                $threshold = (int)$matches[1];
            }

            if ($strictLess) {
                $stmt = $this->db->prepare("
                    SELECT p.*, COALESCE(c.name, 'Aksesoris') AS category_name
                    FROM products p
                    LEFT JOIN categories c ON p.category_id = c.id
                    WHERE p.status = 'active' AND p.stock < ?
                    ORDER BY p.stock ASC
                ");
                $stmt->execute([$threshold]);
                $products = $stmt->fetchAll(PDO::FETCH_ASSOC);
                foreach ($products as &$p) {
                    $p['price_formatted'] = format_rupiah((float)$p['price']);
                }
            } else {
                $products = $this->productService->getProductsByStatus('low_stock', 15);
            }
            $count = count($products);
            $context['last_topic'] = 'low_stock_list';

            if ($count === 0) {
                $comp = $strictLess ? "kurang dari {$threshold} unit" : "menipis (<= {$threshold} unit)";
                return [
                    'success' => true,
                    'reply' => "Berdasarkan data terkini di database toko, saat ini **tidak ada produk aktif yang stoknya {$comp}**. Seluruh stok aksesoris berada dalam kondisi aman! ✨",
                    'products' => [],
                    'suggestions' => ['Produk Aktif', '📊 Ringkasan Produk'],
                    'provider' => 'builtin'
                ];
            }

            $names = [];
            foreach ($products as $p) {
                $names[] = "**{$p['name']}** (SKU: `{$p['sku']}`, sisa **{$p['stock']} unit**, harga: {$p['price_formatted']})";
            }

            $compWord = $strictLess ? "kurang dari {$threshold} unit" : "<= {$threshold} unit";
            $reply = "Berdasarkan data terkini di database toko, terdapat **{$count} produk dengan stok {$compWord}**:\n\n- "
                   . implode("\n- ", $names);

            return [
                'success' => true,
                'reply' => $reply,
                'table' => $this->buildProductsTable($products),
                'products' => $products,
                'suggestions' => ['Produk Aktif', 'Total Stok Fisik', '📊 Ringkasan Produk'],
                'provider' => 'builtin'
            ];
        }
    }

    /**
     * Stock Extremes (Most / Least Stocked Products)
     */
    private function handleStockExtremesQuery(string $normalized, array &$context): array {
        $extremes = $this->productService->getStockExtremes();

        if (str_contains($normalized, 'sedikit') || str_contains($normalized, 'paling kecil') || str_contains($normalized, 'terendah')) {
            $p = $extremes['least_stocked'];
            if (!$p) {
                return ['success' => true, 'reply' => 'Belum ada data produk tersedia.', 'products' => []];
            }
            $reply = "Produk dengan jumlah stok paling sedikit di toko adalah **{$p['name']}** (SKU: `{$p['sku']}`) dengan sisa stok **{$p['stock']} unit** seharga **{$p['price_formatted']}**.";
            return [
                'success' => true,
                'reply' => $reply,
                'products' => [$p],
                'suggestions' => ['Produk Stok Terbanyak', '⚠️ Stok Menipis', '📊 Ringkasan Produk'],
                'provider' => 'builtin'
            ];
        } else {
            // Most stocked
            $p = $extremes['most_stocked'];
            if (!$p) {
                return ['success' => true, 'reply' => 'Belum ada data produk tersedia.', 'products' => []];
            }
            $reply = "Produk dengan jumlah stok paling banyak di toko adalah **{$p['name']}** (SKU: `{$p['sku']}`) dengan ketersediaan **{$p['stock']} unit** seharga **{$p['price_formatted']}**.";
            return [
                'success' => true,
                'reply' => $reply,
                'products' => [$p],
                'suggestions' => ['Produk Stok Paling Sedikit', '✨ Produk Aktif', '📊 Ringkasan Produk'],
                'provider' => 'builtin'
            ];
        }
    }

    /**
     * Total stock units query
     */
    private function handleTotalUnitsStockQuery(array &$context): array {
        $summary = $this->productService->getSummary();
        $reply = "Berdasarkan audit inventaris gudang toko **nnasa_ca**:\n\n"
               . "📦 **Total Unit Stok Fisik Keseluruhan**: **{$summary['total_stock_units']} unit**\n"
               . "✨ **Total Model/Jenis Produk**: **{$summary['total_products']} jenis aksesoris**\n"
               . "🏷️ **Kategori Aktif**: **{$summary['total_categories']} kategori**\n\n"
               . "Seluruh unit ini tersebar pada jepit rambut, scrunchie, kalung, gelang, cincin, anting, dan gift box bundling.";

        return [
            'success' => true,
            'reply' => $reply,
            'stats_card' => [
                ['label' => 'Total Stok Fisik', 'value' => $summary['total_stock_units'] . ' Pcs', 'icon' => 'bi-boxes', 'color' => 'success'],
                ['label' => 'Jenis Produk', 'value' => $summary['total_products'] . ' Model', 'icon' => 'bi-box-seam', 'color' => 'primary']
            ],
            'products' => [],
            'suggestions' => ['📊 Ringkasan Produk', 'Produk Stok Terbanyak', 'Produk Terlaris'],
            'provider' => 'builtin'
        ];
    }

    /**
     * Incomplete product data check
     */
    private function handleIncompleteDataQuery(array &$context, bool $isAdmin = false): array {
        $incomplete = $this->productService->getIncompleteProducts();
        $count = count($incomplete);

        if ($count === 0) {
            $reply = "Seluruh data produk di database telah terisi dengan **lengkap 100%**! Tidak ada produk yang kehilangan deskripsi, foto utama, maupun kategori. Katalog dalam kondisi prima. ✨";
            return [
                'success' => true,
                'reply' => $reply,
                'products' => [],
                'suggestions' => ['📊 Ringkasan Produk', '✨ Produk Aktif'],
                'provider' => 'builtin'
            ];
        }

        $lines = [];
        foreach ($incomplete as $item) {
            $lines[] = "- **{$item['name']}** (SKU: `{$item['sku']}`): {$item['issue']}";
        }

        $reply = "Ditemukan **{$count} produk** yang datanya belum lengkap di database:\n\n" . implode("\n", $lines);
        return [
            'success' => true,
            'reply' => $reply,
            'products' => [],
            'suggestions' => ['Kelola Produk Admin', '📊 Ringkasan Produk'],
            'provider' => 'builtin'
        ];
    }

    /**
     * Category breakdown query
     */
    private function handleCategoryBreakdownQuery(array &$context): array {
        $totalCategories = (int)$this->db->query("SELECT COUNT(*) FROM categories")->fetchColumn();
        $cats = $this->productService->getCategoryBreakdown();

        $lines = [];
        foreach ($cats as $c) {
            $lines[] = "- **{$c['category_name']}**: **{$c['total_products']} model** ({$c['total_units']} unit stok)";
        }

        $reply = "Berdasarkan data terkini di database toko, saat ini terdapat total **{$totalCategories} kategori** yang terdaftar di nnasa_ca.\n\n"
               . "Berikut rincian ketersediaan produk per kategori:\n"
               . implode("\n", $lines);

        return [
            'success' => true,
            'reply' => $reply,
            'products' => [],
            'suggestions' => ['Kalung Rose Gold', 'Aksesoris Rambut', 'Paket Bundling'],
            'provider' => 'builtin'
        ];
    }

    /**
     * Order Lookup / Customer Orders inquiry
     */
    private function handleOrderInquiry(string $original, string $normalized, array &$context, ?array $user): array {
        $userId = $user['id'] ?? null;
        $role = $user['role'] ?? 'public';
        $isAdmin = ($role === 'admin' || $role === 'staff');

        // Check if specific order number is provided (e.g. NNA-20261014-0001)
        if (preg_match('/NNA-[0-9]{8}-[A-Za-z0-9]+/i', $original, $matches)) {
            $orderNumber = strtoupper($matches[0]);
            $order = $this->orderService->lookupOrder($orderNumber, $userId, $isAdmin);

            if (!$order) {
                return [
                    'success' => true,
                    'reply' => "Pesanan dengan nomor **{$orderNumber}** tidak ditemukan di sistem, atau kamu tidak memiliki hak akses untuk melihat pesanan tersebut.",
                    'products' => [],
                    'suggestions' => ['Lacak Pesanan', 'Bantuan FAQ'],
                    'provider' => 'builtin'
                ];
            }

            $statusLabels = [
                'pending' => '⏳ Menunggu Pembayaran',
                'processing' => '📦 Sedang Diproses Penjual',
                'shipped' => '🚚 Dalam Pengiriman',
                'completed' => '✅ Selesai Diterima',
                'cancelled' => '❌ Dibatalkan'
            ];
            $stText = $statusLabels[$order['order_status']] ?? $order['order_status'];

            $reply = "Informasi Pesanan **{$order['order_number']}**:\n\n"
                   . "- Status Pesanan: **{$stText}**\n"
                   . "- Status Pembayaran: **" . strtoupper($order['payment_status']) . "**\n"
                   . "- Total Belanja: **" . format_rupiah((float)$order['total_amount']) . "**\n"
                   . "- Tanggal Pemesanan: " . date('d M Y, H:i', strtotime($order['created_at'])) . " WIB\n";

            if (!empty($order['shipment']['tracking_number'])) {
                $reply .= "- Kurir Pengiriman: **{$order['shipment']['courier']}** (No. Resi: `{$order['shipment']['tracking_number']}`)\n";
            }

            return [
                'success' => true,
                'reply' => $reply,
                'products' => [],
                'suggestions' => ['Lacak Resi Pengiriman', 'Pesanan Saya'],
                'provider' => 'builtin'
            ];
        }

        // If asking for personal orders
        if ($isAdmin) {
            // Khusus Admin / Staff: Query data operasional pesanan toko secara real-time
            $pendingOrders = (int)$this->db->query("SELECT COUNT(*) FROM orders WHERE order_status = 'pending'")->fetchColumn();
            $processingOrders = (int)$this->db->query("SELECT COUNT(*) FROM orders WHERE order_status = 'processing'")->fetchColumn();
            $completedOrders = (int)$this->db->query("SELECT COUNT(*) FROM orders WHERE order_status IN ('completed', 'delivered')")->fetchColumn();
            $lowStock = (int)$this->db->query("SELECT COUNT(*) FROM products WHERE stock <= 5 AND status = 'active'")->fetchColumn();

            // Coba tanyakan ke LLM Provider aktif (Gemini) yang sudah ter-grounding data DB
            $llmResponse = $this->queryLLMProvider($original, $normalized, $context, $user);
            if ($llmResponse !== null && !empty($llmResponse['reply'])) {
                return $llmResponse;
            }

            // Fallback deterministik cerdas jika API sedang nonaktif/offline
            $adminName = $user['name'] ?? 'Admin';
            if (str_contains($normalized, 'belum bayar') || str_contains($normalized, 'pending')) {
                $reply = "Saat ini terdapat **{$pendingOrders} pesanan** yang belum dibayar, Admin {$adminName}.";
            } elseif (str_contains($normalized, 'proses') || str_contains($normalized, 'processing')) {
                $reply = "Saat ini terdapat **{$processingOrders} pesanan** yang perlu diproses, Admin {$adminName}.";
            } else {
                $reply = "Halo Admin {$adminName}! Data pesanan toko saat ini:\n\n"
                       . "• ⏳ **Pesanan Belum Bayar**: **{$pendingOrders} pesanan**\n"
                       . "• 📦 **Pesanan Perlu Diproses**: **{$processingOrders} pesanan**\n"
                       . "• ✅ **Pesanan Selesai**: **{$completedOrders} pesanan**\n"
                       . "• ⚠️ **Stok Menipis (≤ 5 pcs)**: **{$lowStock} produk**\n\n"
                       . "Kamu dapat mengelolanya langsung di menu Manajemen Pesanan.";
            }

            return [
                'success' => true,
                'reply' => $reply,
                'products' => [],
                'suggestions' => ['Pesanan Perlu Diproses', 'Pesanan Belum Bayar', '⚠️ Stok Menipis', '📊 Ringkasan Produk'],
                'provider' => 'builtin'
            ];
        }

        // If asking for personal orders (Customer biasa)
        if ($userId) {
            $summary = $this->orderService->getUserOrdersSummary($userId);
            if ($summary['total_orders'] === 0) {
                return [
                    'success' => true,
                    'reply' => "Kamu belum memiliki riwayat pesanan di nnasa_ca. Yuk jelajahi katalog aksesoris cantik kami dan nikmati diskon spesial!",
                    'products' => [],
                    'suggestions' => ['Katalog Semua Produk', 'Promo & Diskon'],
                    'provider' => 'builtin'
                ];
            }

            $reply = "Kamu memiliki total **{$summary['total_orders']} pesanan** di nnasa_ca.\n";
            if ($summary['latest_order']) {
                $lo = $summary['latest_order'];
                $reply .= "Pesanan terakhir kamu: **{$lo['order_number']}** (Status: **" . strtoupper($lo['order_status']) . "**, Total: " . format_rupiah((float)$lo['total_amount']) . ").\n\n";
            }
            $reply .= "Kamu bisa memantau posisi pengiriman paket secara real-time di halaman [Lacak Pesanan]({$this->getBaseUrl()}tracking.php) atau melihat rincian di [Pesanan Saya]({$this->getBaseUrl()}orders.php).";

            return [
                'success' => true,
                'reply' => $reply,
                'products' => [],
                'suggestions' => ['Buka Pesanan Saya', 'Lacak Pesanan', 'Katalog Produk'],
                'provider' => 'builtin'
            ];
        } else {
            return [
                'success' => true,
                'reply' => "Untuk melacak pengiriman paket atau mengecek status pesanan, kamu bisa langsung memasukkan nomor pesanan kamu (contoh: `NNA-20261014-0001`) di halaman [Lacak Pesanan]({$this->getBaseUrl()}tracking.php) atau [Login ke Akun]({$this->getBaseUrl()}login.php).",
                'products' => [],
                'suggestions' => ['Lacak Pesanan', 'Login Akun', 'Hubungi WhatsApp'],
                'provider' => 'builtin'
            ];
        }
    }

    /**
     * Admin Revenue & Financial Inquiries (RBAC Guarded)
     */
    private function handleRevenueQuery(string $normalized, array &$context, ?array $user): array {
        $role = $user['role'] ?? 'public';

        if ($role !== 'admin' && $role !== 'staff') {
            return [
                'success' => true,
                'reply' => "🔒 **Akses Dibatasi**: Informasi omzet, rincian keuangan, dan analitik pendapatan toko bersifat rahasia dan hanya dapat diakses oleh Administrator/Staf toko yang telah login ke Panel Admin. Silakan tanyakan informasi produk, harga, atau stok ya! 🌸",
                'products' => [],
                'suggestions' => ['💎 Aksesoris Murah', '📊 Ringkasan Produk', 'Katalog Produk'],
                'provider' => 'builtin'
            ];
        }

        // Check timeframe: Minggu Ini vs Hari Ini vs Bulan Ini vs Lifetime
        $isWeek = str_contains($normalized, 'minggu') || str_contains($normalized, 'pekan') || str_contains($normalized, 'week');
        $isToday = str_contains($normalized, 'hari ini') || str_contains($normalized, 'today');
        $isMonth = str_contains($normalized, 'bulan') || str_contains($normalized, 'month');

        if ($isWeek || $isToday || $isMonth) {
            $timeframeLabel = 'Minggu Ini (7 Hari Terakhir)';
            $dateCondition = "created_at >= DATE_SUB(NOW(), INTERVAL 7 DAY)";

            if ($isToday) {
                $timeframeLabel = 'Hari Ini (' . date('d M Y') . ')';
                $dateCondition = "DATE(created_at) = CURDATE()";
            } elseif ($isMonth) {
                $timeframeLabel = 'Bulan Ini (' . date('F Y') . ')';
                $dateCondition = "created_at >= DATE_SUB(NOW(), INTERVAL 30 DAY)";
            }

            $stmtSales = $this->db->query("
                SELECT 
                    COUNT(*) AS total_orders,
                    COALESCE(SUM(total_amount), 0) AS total_amount,
                    COALESCE(SUM(CASE WHEN payment_status = 'paid' THEN total_amount ELSE 0 END), 0) AS paid_revenue,
                    SUM(CASE WHEN payment_status = 'paid' THEN 1 ELSE 0 END) AS paid_orders,
                    SUM(CASE WHEN order_status = 'completed' THEN 1 ELSE 0 END) AS completed_orders,
                    SUM(CASE WHEN order_status = 'processing' THEN 1 ELSE 0 END) AS processing_orders,
                    SUM(CASE WHEN order_status = 'shipped' THEN 1 ELSE 0 END) AS shipped_orders,
                    SUM(CASE WHEN order_status = 'pending' THEN 1 ELSE 0 END) AS pending_orders,
                    SUM(CASE WHEN order_status = 'cancelled' THEN 1 ELSE 0 END) AS cancelled_orders
                FROM orders
                WHERE {$dateCondition}
            ");
            $sales = $stmtSales->fetch(PDO::FETCH_ASSOC) ?: [];

            // Top items in timeframe
            $stmtTop = $this->db->query("
                SELECT oi.product_name_snapshot, SUM(oi.quantity) AS qty_sold, SUM(oi.subtotal) AS total_val
                FROM order_items oi
                JOIN orders o ON oi.order_id = o.id
                WHERE o.{$dateCondition} AND o.payment_status = 'paid'
                GROUP BY oi.product_name_snapshot
                ORDER BY qty_sold DESC
                LIMIT 5
            ");
            $topItems = $stmtTop->fetchAll(PDO::FETCH_ASSOC);

            $paidRevFormatted = format_rupiah((float)($sales['paid_revenue'] ?? 0));
            $reply = "📊 **Ringkasan Performa Penjualan — {$timeframeLabel}**:\n\n"
                   . "- **Total Pendapatan Lunas**: **{$paidRevFormatted}**\n"
                   . "- **Total Pesanan Masuk**: **" . ($sales['total_orders'] ?? 0) . " pesanan**\n"
                   . "  • Lunas / Terbayar: " . ($sales['paid_orders'] ?? 0) . " pesanan\n"
                   . "  • Pesanan Selesai: " . ($sales['completed_orders'] ?? 0) . "\n"
                   . "  • Sedang Diproses: " . ($sales['processing_orders'] ?? 0) . "\n"
                   . "  • Dalam Pengiriman: " . ($sales['shipped_orders'] ?? 0) . "\n"
                   . "  • Menunggu Pembayaran: " . ($sales['pending_orders'] ?? 0) . "\n"
                   . "  • Dibatalkan: " . ($sales['cancelled_orders'] ?? 0) . "\n";

            if (!empty($topItems)) {
                $reply .= "\n🔥 **Produk Terlaris Periode Ini**:\n";
                foreach ($topItems as $idx => $ti) {
                    $valFormatted = format_rupiah((float)$ti['total_val']);
                    $reply .= ($idx + 1) . ". **{$ti['product_name_snapshot']}** — terjual **{$ti['qty_sold']} pcs** (Omzet: {$valFormatted})\n";
                }
            }

            return [
                'success' => true,
                'reply' => $reply,
                'stats_card' => [
                    ['label' => 'Pendapatan ' . ($isToday ? 'Hari Ini' : ($isWeek ? 'Minggu Ini' : 'Bulan Ini')), 'value' => $paidRevFormatted, 'icon' => 'bi-cash-coin', 'color' => 'success'],
                    ['label' => 'Pesanan Diproses', 'value' => ($sales['processing_orders'] ?? 0) . ' Order', 'icon' => 'bi-hourglass-split', 'color' => 'warning'],
                    ['label' => 'Pesanan Selesai', 'value' => ($sales['completed_orders'] ?? 0) . ' Order', 'icon' => 'bi-check2-circle', 'color' => 'info']
                ],
                'products' => [],
                'suggestions' => ['Penjualan Hari Ini', 'Total Omzet Keseluruhan', '⚠️ Stok Menipis'],
                'provider' => 'builtin'
            ];
        }

        // Admin Access Granted (Lifetime)
        $rev = $this->orderService->getAdminRevenueSummary();

        $reply = "📊 **Ringkasan Keuangan & Pesanan Toko (Khusus Admin)**:\n\n"
               . "- **Total Omzet Valid**: **{$rev['total_revenue_formatted']}**\n"
               . "- **Omzet Lunas Hari Ini**: **{$rev['today_revenue_formatted']}**\n"
               . "- **Total Semua Pesanan**: **{$rev['total_orders']} pesanan**\n"
               . "  • Menunggu Pembayaran: {$rev['pending_orders']}\n"
               . "  • Sedang Diproses: {$rev['processing_orders']}\n"
               . "  • Dalam Pengiriman: {$rev['shipped_orders']}\n"
               . "  • Pesanan Selesai: {$rev['completed_orders']}\n"
               . "  • Dibatalkan: {$rev['cancelled_orders']}\n\n"
               . "Data diambil secara real-time dari database produksi.";

        return [
            'success' => true,
            'reply' => $reply,
            'stats_card' => [
                ['label' => 'Total Omzet', 'value' => $rev['total_revenue_formatted'], 'icon' => 'bi-cash-coin', 'color' => 'success'],
                ['label' => 'Pesanan Diproses', 'value' => $rev['processing_orders'] . ' Order', 'icon' => 'bi-hourglass-split', 'color' => 'warning'],
                ['label' => 'Pesanan Selesai', 'value' => $rev['completed_orders'] . ' Order', 'icon' => 'bi-check2-circle', 'color' => 'info']
            ],
            'products' => [],
            'suggestions' => ['Performa Penjualan Minggu Ini', 'Laporan Penjualan Hari Ini', '📊 Ringkasan Produk'],
            'provider' => 'builtin'
        ];
    }

    /**
     * Platform Feature Search (Feature Registry Navigator)
     */
    private function handleFeatureSearch(string $normalized, string $role): ?array {
        // Jangan intersep pertanyaan data/agregasi atau identitas (misal: "berapa total pengguna", "siapa saya")
        if (
            str_contains($normalized, 'berapa') ||
            str_contains($normalized, 'total') ||
            str_contains($normalized, 'jumlah') ||
            str_contains($normalized, 'hitung') ||
            str_contains($normalized, 'siapa') ||
            str_contains($normalized, 'banyak')
        ) {
            return null;
        }

        $featureKeywords = ['fitur', 'halaman', 'menu', 'buka', 'di mana', 'dimana', 'bagaimana', 'cara buka', 'navigasi', 'dasbor', 'dashboard', 'manajemen user', 'manajemen pengguna'];
        $hasFeatureQuery = false;
        foreach ($featureKeywords as $kw) {
            if (str_contains($normalized, $kw)) {
                $hasFeatureQuery = true;
                break;
            }
        }

        $matches = FeatureRegistry::searchFeatures($normalized, $role);
        if (!$hasFeatureQuery && (empty($matches) || $matches[0]['score'] < 16)) {
            return null;
        }
        if (empty($matches)) return null;

        $top = $matches[0];
        $baseUrl = $this->getBaseUrl();
        $targetUrl = $baseUrl . $top['url'];

        $reply = "📌 **Fitur Platform: {$top['name']}**\n\n"
               . "{$top['description']}\n\n"
               . "Kamu bisa langsung mengaksesnya melalui tautan: [Buka {$top['name']}]({$targetUrl})";

        if (count($matches) > 1) {
            $otherLinks = [];
            for ($i = 1; $i < min(4, count($matches)); $i++) {
                $otherLinks[] = "- [{$matches[$i]['name']}]({$baseUrl}{$matches[$i]['url']})";
            }
            $reply .= "\n\nFitur terkait lainnya:\n" . implode("\n", $otherLinks);
        }

        return [
            'success' => true,
            'reply' => $reply,
            'products' => [],
            'suggestions' => ['Katalog Produk', 'Bantuan FAQ', '📊 Ringkasan Produk'],
            'provider' => 'builtin'
        ];
    }

    /**
     * Helper to render structured products table
     */
    private function buildProductsTable(array $products): array {
        $rows = [];
        foreach ($products as $p) {
            $rows[] = [
                'sku' => $p['sku'],
                'name' => $p['name'],
                'category' => $p['category_name'],
                'price' => $p['price_formatted'],
                'stock' => $p['stock'] . ' unit',
                'status' => strtoupper($p['status'])
            ];
        }
        return [
            'headers' => ['SKU', 'Nama Produk', 'Kategori', 'Harga', 'Stok', 'Status'],
            'rows' => $rows
        ];
    }

    /**
     * Price filter query
     */
    private function handlePriceFilterQuery(string $normalized, array &$context): array {
        $maxPrice = null;
        if (preg_match('/(di bawah|dibawah|kurang dari|maksimal|budget)\s*(rp\.?|rp)?\s*([0-9]+)(\s*rb|\s*ribu|\.000)?/i', $normalized, $matches)) {
            $num = (int)$matches[3];
            if (isset($matches[4]) && (str_contains($matches[4], 'rb') || str_contains($matches[4], 'ribu') || str_contains($matches[4], '.000'))) {
                $maxPrice = $num * 1000;
            } else {
                $maxPrice = $num <= 500 ? $num * 1000 : $num;
            }
        } elseif (str_contains($normalized, 'murah') || str_contains($normalized, 'terjangkau') || str_contains($normalized, 'hemat')) {
            $maxPrice = 35000;
        }

        $filters = [
            'status' => 'active',
            'max_price' => $maxPrice,
            'sort' => 'price_asc',
            'limit' => 4
        ];
        $products = $this->productService->searchProductsStructured($filters);

        if (empty($products)) {
            return [
                'success' => true,
                'reply' => "Saat ini kami belum memiliki produk aktif dengan rentang harga tersebut. Koleksi aksesoris kami dimulai dari Rp 16.500 (Scrunchie Sutra Organza).",
                'products' => [],
                'suggestions' => ['Scrunchie Pastel', 'Jepit Korea', 'Semua Produk'],
                'provider' => 'builtin'
            ];
        }

        $context['last_products'] = $products;
        $context['focused_product'] = $products[0];
        $context['last_topic'] = 'cheap_products';

        $reply = $maxPrice !== null 
            ? "Tentu! Ini beberapa pilihan aksesoris cantik dengan harga terjangkau (di bawah " . format_rupiah($maxPrice) . ") yang siap kamu pesan:"
            : "Ini beberapa rekomendasi aksesoris termurah dan terfavorit di nnasa_ca:";

        return [
            'success' => true,
            'reply' => $reply,
            'products' => $products,
            'suggestions' => ['Kalau yang warna hitam ada?', 'Berapa Harganya?', 'Cara Membeli'],
            'provider' => 'builtin'
        ];
    }

    /**
     * Recommendation / Best Sellers / New arrivals
     */
    private function handleRecommendationQuery(string $normalized, array &$context): array {
        if (str_contains($normalized, 'kado') || str_contains($normalized, 'hadiah') || str_contains($normalized, 'hampers')) {
            $products = $this->productService->searchProductsStructured(['category_id' => 10, 'limit' => 2]);
            if (!empty($products)) {
                $context['last_products'] = $products;
                $context['focused_product'] = $products[0];

                return [
                    'success' => true,
                    'reply' => "Untuk hadiah atau kado istimewa, aku sangat merekomendasikan **{$products[0]['name']}**! Paket ini sudah berisi 4 aksesoris lengkap (kalung, gelang, anting, dan jepit) yang dikemas dalam exclusive hardbox berpita cantik & kartu ucapan elegan. Pasti bikin yang menerima bahagia! ✨",
                    'products' => $products,
                    'suggestions' => ['Berapa Harganya?', 'Lihat Detail Paket', 'Rekomendasi Lainnya'],
                    'provider' => 'builtin'
                ];
            }
        }

        if (str_contains($normalized, 'baru') || str_contains($normalized, 'terbaru') || str_contains($normalized, 'new')) {
            $products = $this->productService->getRecentProducts(4);
            $count = count($products);
            $context['last_products'] = $products;

            return [
                'success' => true,
                'reply' => "Berikut adalah **{$count} produk terbaru** yang baru saja ditambahkan ke dalam katalog nnasa_ca:",
                'table' => $this->buildProductsTable($products),
                'products' => $products,
                'suggestions' => ['Lihat Semua Produk', 'Produk Terlaris', 'Cek Diskon'],
                'provider' => 'builtin'
            ];
        }

        // Default: Best sellers
        $products = $this->productService->searchProductsStructured(['status' => 'active', 'sort' => 'sales', 'limit' => 3]);
        $context['last_products'] = $products;

        return [
            'success' => true,
            'reply' => "Berikut adalah **produk terlaris (Best Seller)** di nnasa_ca yang paling banyak diminati pelanggan kami:",
            'products' => $products,
            'suggestions' => ['Aksesoris Murah', 'Cek Stok Kalung', 'Cara Pesan'],
            'provider' => 'builtin'
        ];
    }

    /**
     * Category query
     */
    private function handleCategoryQuery(array $cat, string $normalized, array &$context): array {
        $products = $this->productService->searchProductsStructured([
            'status' => 'active',
            'category_id' => $cat['id'],
            'sort' => 'sales',
            'limit' => 4
        ]);

        if (empty($products)) {
            return [
                'success' => true,
                'reply' => "Saat ini produk pada kategori **{$cat['name']}** sedang dalam persiapan penambahan stok baru.",
                'products' => [],
                'suggestions' => ['Kategori Lainnya', 'Koleksi Terlaris'],
                'provider' => 'builtin'
            ];
        }

        $context['last_products'] = $products;
        $context['focused_product'] = $products[0];

        return [
            'success' => true,
            'reply' => "Berikut pilihan aksesoris cantik dalam kategori **{$cat['name']}**:",
            'products' => $products,
            'suggestions' => ['Urutkan Paling Murah', 'Varian Warna Apa Saja?', 'Cara Membeli'],
            'provider' => 'builtin'
        ];
    }

    /**
     * General Product Search
     */
    private function handleGeneralProductSearch(string $normalized, array &$context): ?array {
        $stopWords = ['apakah', 'ada', 'punya', 'jual', 'toko', 'kak', 'kakak', 'min', 'admin', 'bisa', 'tolong', 'cari', 'carikan', 'lihat', 'koleksi', 'mau', 'beli', 'dong'];
        $cleanTokens = array_filter(explode(' ', $normalized), function($w) use ($stopWords) {
            return strlen($w) > 2 && !in_array($w, $stopWords);
        });

        if (empty($cleanTokens)) {
            return null;
        }

        $term = implode(' ', $cleanTokens);
        $products = $this->productService->searchProductsStructured([
            'status' => 'active',
            'name' => $term,
            'limit' => 4
        ]);

        if (!empty($products)) {
            $context['last_products'] = $products;
            $context['focused_product'] = $products[0];

            return [
                'success' => true,
                'reply' => "Aku menemukan " . count($products) . " produk yang sesuai dengan pencarian kamu:",
                'products' => $products,
                'suggestions' => ['Berapa Harganya?', 'Cek Stok Produk Ini', 'Cara Memesan'],
                'provider' => 'builtin'
            ];
        }

        return null;
    }

    /**
     * Specific product stock check
     */
    private function handleSpecificStockQuery(string $normalized, array &$context): ?array {
        // Strip out question words
        $clean = preg_replace('/\b(berapa|brp|stok|stock|stoknya|jumlah|unit|tersedia|ready|apakah|ada|produk)\b/i', '', $normalized);
        $clean = trim($clean);

        if (strlen($clean) >= 3) {
            $detail = $this->productService->getProductStock($clean);
            if ($detail) {
                $context['last_products'] = [$detail];
                $context['focused_product'] = $detail;

                $stockText = $detail['stock'] > 0
                    ? "Produk **{$detail['name']}** (SKU: `{$detail['sku']}`) saat ini **tersedia dengan stok {$detail['stock']} unit** seharga **{$detail['price_formatted']}**."
                    : "Mohon maaf, produk **{$detail['name']}** saat ini stoknya sedang habis.";

                if (!empty($detail['variants'])) {
                    $vLines = [];
                    foreach ($detail['variants'] as $v) {
                        $vLines[] = "- {$v['variant_name']} **{$v['variant_value']}**: stok {$v['stock']} pcs";
                    }
                    $stockText .= "\n\nRincian stok per varian:\n" . implode("\n", $vLines);
                }

                return [
                    'success' => true,
                    'reply' => $stockText,
                    'products' => [$detail],
                    'suggestions' => ['Lihat Detail Produk', 'Berapa Harganya?', 'Cari Aksesoris Lain'],
                    'provider' => 'builtin'
                ];
            }
        }

        return null;
    }

