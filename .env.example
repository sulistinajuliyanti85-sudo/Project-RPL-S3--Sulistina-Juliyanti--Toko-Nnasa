# ==============================================================================
# NNASA_CA - TEMPLATE ENVIRONMENT CONFIGURATION (.env.example)
# Salin file ini menjadi .env lalu isi nilai token rahasia pada server Anda.
# ==============================================================================

# Master App Encryption Key (AES-256)
APP_KEY=base64_or_hex_32_bytes_random_secret_key_here

# WhatsApp Official / Gateway OTP Configuration
# Provider yang didukung: fonnte, wablas, meta_cloud, generic
WHATSAPP_PROVIDER=fonnte
WHATSAPP_API_TOKEN=ISI_TOKEN_BARU_DI_SERVER
WHATSAPP_API_URL=https://api.fonnte.com/send
WHATSAPP_SENDER_ID=NNASA_CA
WHATSAPP_OTP_TEMPLATE="Kode verifikasi nnasa_ca kamu adalah {{otp}}. Kode ini berlaku selama {{expiry_minutes}} menit. Jangan bagikan kode kepada siapa pun. Jika kamu tidak meminta kode ini, abaikan pesan ini."

# AI LLM Provider Configuration
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
