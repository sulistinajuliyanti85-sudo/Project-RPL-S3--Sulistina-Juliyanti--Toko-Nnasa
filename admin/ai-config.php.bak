<script>
const ADMIN_API_AI = '<?= BASE_URL ?>api/admin/ai.php';

// 1. Quick Test Active Provider
function testActiveProviderQuick() {
  const alertBox = document.getElementById('quickTestAlert');
  alertBox.style.display = 'block';
  alertBox.className = 'alert alert-info py-2 small';
  alertBox.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Menghubungi API provider aktif...';

  const formData = new FormData();
  formData.append('action', 'test_connection');
  formData.append('provider_id', '<?= (int)($metrics['active_provider']['id'] ?? 1) ?>');

  fetch(ADMIN_API_AI, {
    method: 'POST',
    body: formData
  })
  .then(res => res.json())
  .then(data => {
    if (data.success) {
      alertBox.className = 'alert alert-success py-2 small';
      alertBox.innerHTML = `<i class="bi bi-check-circle me-1"></i> ${data.message} (${data.latency_ms} ms)`;
    } else {
      alertBox.className = 'alert alert-danger py-2 small';
      alertBox.innerHTML = `<i class="bi bi-x-circle me-1"></i> ${data.message}`;
    }
  })
  .catch(err => {
    alertBox.className = 'alert alert-danger py-2 small';
    alertBox.innerHTML = 'Gagal menghubungi server.';
  });
}

// 2. Test Specific Provider Connection
function testProviderConnection(providerId) {
  const alertBox = document.getElementById('providerAlert_' + providerId);
  if (alertBox) {
    alertBox.style.display = 'block';
    alertBox.className = 'alert alert-info py-2 small';
    alertBox.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Menguji koneksi...';
  }

  const form = document.getElementById('formProvider_' + providerId);
  const formData = new FormData(form);
  formData.append('action', 'test_connection');

  fetch(ADMIN_API_AI, {
    method: 'POST',
    body: formData
  })
  .then(res => res.json())
  .then(data => {
    if (alertBox) {
      alertBox.className = data.success ? 'alert alert-success py-2 small' : 'alert alert-danger py-2 small';
      alertBox.innerHTML = (data.success ? '<i class="bi bi-check-circle me-1"></i> ' : '<i class="bi bi-x-circle me-1"></i> ') + data.message + ` (${data.latency_ms} ms)`;
    }
  })
  .catch(err => {
    if (alertBox) {
      alertBox.className = 'alert alert-danger py-2 small';
      alertBox.innerHTML = 'Gagal melakukan pengujian koneksi.';
    }
  });
}

// 3. Submit Provider Config
function submitProviderConfig(e, providerId) {
  e.preventDefault();
  const alertBox = document.getElementById('providerAlert_' + providerId);
  const formData = new FormData(e.target);
  formData.append('action', 'save_provider');

  fetch(ADMIN_API_AI, {
    method: 'POST',
    body: formData
  })
  .then(res => res.json())
  .then(data => {
    if (alertBox) {
      alertBox.style.display = 'block';
      alertBox.className = data.success ? 'alert alert-success py-2 small' : 'alert alert-danger py-2 small';
      alertBox.innerHTML = data.message;
    }
    if (data.success) {
      setTimeout(() => location.reload(), 1200);
    }
  });
}

// 3b. Quick Toggle Provider Active
function quickToggleProviderActive(providerId, checkboxElem) {
  const isChecked = checkboxElem.checked;
  const alertBox = document.getElementById('providerAlert_' + providerId);

  const formData = new FormData();
  formData.append('action', 'set_active_provider');
  formData.append('provider_id', providerId);
  formData.append('csrf_token', '<?= $csrfToken ?>');

  fetch(ADMIN_API_AI, {
    method: 'POST',
    body: formData
  })
  .then(res => res.json())
  .then(data => {
    if (alertBox) {
      alertBox.style.display = 'block';
      alertBox.className = data.success ? 'alert alert-success py-2 small' : 'alert alert-danger py-2 small';
      alertBox.innerHTML = data.message;
    }
    if (data.success) {
      setTimeout(() => location.reload(), 600);
    } else {
      checkboxElem.checked = !isChecked;
    }
  })
  .catch(err => {
    console.error(err);
    checkboxElem.checked = !isChecked;
  });
}

