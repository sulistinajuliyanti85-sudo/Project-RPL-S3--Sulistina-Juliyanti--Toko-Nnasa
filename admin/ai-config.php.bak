// 11. Playground Testing & Quick Scenarios
function submitPlaygroundTest(e) {
  e.preventDefault();
  const input = document.getElementById('playgroundInput');
  const msg = input.value.trim();
  if (!msg) return;

  const chatBox = document.getElementById('playgroundChatBox');
  chatBox.innerHTML += `
    <div class="text-end mb-2">
      <div class="d-inline-block bg-primary-pink text-white p-2 rounded-3 text-start small shadow-sm" style="max-width: 80%;">
        ${escapeHtml(msg)}
      </div>
    </div>
    <div id="tempBotLoading" class="text-start mb-2">
      <div class="d-inline-block bg-white text-muted p-2 rounded-3 border small shadow-sm">
        <span class="spinner-border spinner-border-sm text-primary-pink me-2"></span>Menghubungi AI...
      </div>
    </div>
  `;
  chatBox.scrollTop = chatBox.scrollHeight;
  input.value = '';

  const formData = new FormData();
  formData.append('action', 'playground_test');
  formData.append('message', msg);
  formData.append('csrf_token', '<?= $csrfToken ?>');

  fetch(ADMIN_API_AI, {
    method: 'POST',
    body: formData
  })
  .then(res => res.json())
  .then(data => {
    const loader = document.getElementById('tempBotLoading');
    if (loader) loader.remove();

    if (data.success) {
      chatBox.innerHTML += `
        <div class="text-start mb-2">
          <div class="d-inline-block bg-white text-dark p-3 rounded-3 border small shadow-sm" style="max-width: 85%;">
            <div class="fw-bold text-primary-pink mb-1" style="font-size:11px;">
              <i class="bi bi-robot me-1"></i>${escapeHtml(data.provider)} (${escapeHtml(data.model)}) — ${data.latency_ms} ms
            </div>
            <div style="white-space: pre-wrap;">${escapeHtml(data.reply)}</div>
          </div>
        </div>
      `;
      // Update diagnostics
      document.getElementById('diagStatus').innerHTML = '<span class="text-success"><i class="bi bi-check-circle"></i> Berhasil</span>';
      document.getElementById('diagLatency').innerText = data.latency_ms + ' ms';
      document.getElementById('diagTokens').innerText = (data.input_tokens || 0) + ' / ' + (data.output_tokens || 0);
      document.getElementById('diagModel').innerText = data.model;
    } else {
      chatBox.innerHTML += `
        <div class="text-start mb-2">
          <div class="d-inline-block bg-danger-subtle text-danger p-2 rounded-3 border border-danger small shadow-sm" style="max-width: 85%;">
            <i class="bi bi-exclamation-triangle-fill me-1"></i> ${escapeHtml(data.message || data.error || 'Terjadi kesalahan')}
          </div>
        </div>
      `;
      document.getElementById('diagStatus').innerHTML = '<span class="text-danger"><i class="bi bi-x-circle"></i> Gagal</span>';
    }
    chatBox.scrollTop = chatBox.scrollHeight;
  })
  .catch(err => {
    const loader = document.getElementById('tempBotLoading');
    if (loader) loader.remove();
    chatBox.innerHTML += `
      <div class="text-start mb-2">
        <div class="d-inline-block bg-danger-subtle text-danger p-2 rounded-3 border border-danger small shadow-sm">
          Gagal menghubungi endpoint playground.
        </div>
      </div>
    `;
  });
}

function runScenario(promptText) {
  document.getElementById('playgroundInput').value = promptText;
  document.getElementById('btnSendPlayground').click();
}

function clearPlaygroundChat() {
  document.getElementById('playgroundChatBox').innerHTML = `
    <div class="text-center text-muted small my-3">
      <i class="bi bi-robot fs-3 d-block mb-1 text-primary-pink"></i>
      Obrolan telah dibersihkan.
    </div>
  `;
}

// 12. Load Usage Logs
function loadUsageLogs() {
  const tbody = document.getElementById('usageLogsBody');
  tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-muted"><span class="spinner-border spinner-border-sm me-2"></span>Memuat...</td></tr>';

  fetch(ADMIN_API_AI + '?action=get_logs')
  .then(res => res.json())
  .then(data => {
    if (data.success && data.logs.length > 0) {
      let rows = '';
      data.logs.forEach(l => {
        const statusBadge = l.request_status === 'success' 
          ? '<span class="badge bg-success-subtle text-success">Berhasil</span>' 
          : '<span class="badge bg-danger-subtle text-danger">Gagal</span>';
        rows += `
          <tr>
            <td>${l.created_at}</td>
            <td>${escapeHtml(l.user_name || 'Guest / Sistem')}</td>
            <td><strong>${escapeHtml(l.provider_name || '-')}</strong> / ${escapeHtml(l.model_name || '-')}</td>
            <td>${l.input_tokens} / ${l.output_tokens}</td>
            <td>${l.latency_ms} ms</td>
            <td>$${parseFloat(l.estimated_cost || 0).toFixed(6)}</td>
            <td>${statusBadge}</td>
          </tr>
        `;
      });
      tbody.innerHTML = rows;
    } else {
      tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4 text-muted">Belum ada catatan log penggunaan AI.</td></tr>';
    }
  });
}

function togglePasswordVis(inputId) {
  const input = document.getElementById(inputId);
  if (input) {
    input.type = input.type === 'password' ? 'text' : 'password';
  }
}

function escapeHtml(text) {
  if (!text) return '';
  const map = {'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;'};
  return text.toString().replace(/[&<>"']/g, m => map[m]);
}

function nl2br(str) {
  if (!str) return '';
  return str.replace(/\r\n|\n\r|\r|\n/g, '<br>');
}

// 13. Modal Playground Uji Model AI (Event Listeners & AJAX)
document.addEventListener('DOMContentLoaded', function() {
  const modalElem = document.getElementById('modalTestModel');
  const testModal = modalElem ? new bootstrap.Modal(modalElem) : null;

  // Tangkap klik tombol Uji pada tabel Daftar Model
  document.querySelectorAll('.btn-test-model').forEach(function(btn) {
    btn.addEventListener('click', function() {
      const modelId = this.getAttribute('data-model-id') || '';
      const modelName = this.getAttribute('data-model-name') || '';
      const displayName = this.getAttribute('data-display-name') || modelName;
      const providerId = this.getAttribute('data-provider-id') || '';
      const providerName = this.getAttribute('data-provider-name') || 'Google Gemini AI';

      // Isi info ke dalam Modal
      document.getElementById('testModalModelId').value = modelId;
      document.getElementById('testModalProviderId').value = providerId;
      document.getElementById('testModelTitle').textContent = displayName;
      document.getElementById('testModalProviderBadge').textContent = providerName;
      document.getElementById('testModalNameBadge').textContent = modelName;

      // Reset area hasil balasan AI
      const resultBox = document.getElementById('testModalResultBox');
      resultBox.value = '';
      resultBox.placeholder = 'Hasil respons AI akan tampil di sini setelah prompt dikirim...';
      document.getElementById('testModalLatencyBadge').style.display = 'none';

      // Buka Bootstrap Modal
      if (testModal) {
        testModal.show();
      }
    });
  });
});

function submitTestModelModal(e) {
  e.preventDefault();
  const form = e.target;
  const btnSubmit = document.getElementById('btnSubmitTestModal');
  const resultBox = document.getElementById('testModalResultBox');
  const latencyBadge = document.getElementById('testModalLatencyBadge');
  const originalBtnHtml = btnSubmit.innerHTML;

  // Ubah status tombol jadi Loading...
  btnSubmit.disabled = true;
  btnSubmit.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span>Loading...';

  // Area hasil loading
  resultBox.value = 'Menghubungi server AI dan menunggu balasan...';
  latencyBadge.style.display = 'none';

  const formData = new FormData(form);
  formData.append('action', 'test_prompt');

  fetch(ADMIN_API_AI, {
    method: 'POST',
    body: formData
  })
  .then(res => res.json())
  .then(res => {
    btnSubmit.disabled = false;
    btnSubmit.innerHTML = originalBtnHtml;

    const isSuccess = (res.status === 'success' || res.success === true);
    const replyText = res.data || res.reply || res.message;
    const latency = res.latency_ms || res.latency || 0;

    if (isSuccess && replyText) {
      resultBox.value = replyText;
      if (latency > 0) {
        latencyBadge.textContent = latency + ' ms';
        latencyBadge.className = 'badge bg-success-subtle text-success';
        latencyBadge.style.display = 'inline-block';
      }
    } else {
      resultBox.value = 'Error: ' + (res.error || res.message || 'Gagal memproses respons dari model AI.');
    }
  })
  .catch(err => {
    btnSubmit.disabled = false;
    btnSubmit.innerHTML = originalBtnHtml;
    resultBox.value = 'Error: Terjadi kesalahan jaringan atau server tidak merespons.';
    console.error(err);
  });
}

// Auto load logs when logs tab opened
document.getElementById('tab-logs-btn').addEventListener('shown.bs.tab', loadUsageLogs);
</script>

